From 535b9c1af7a156491ffdffb6d8694ed28064e8c5 Mon Sep 17 00:00:00 2001
From: "jiazheng.yin" <jiazheng.yin@gl-inet.com>
Date: Thu, 9 Apr 2026 15:21:10 +0800
Subject: [PATCH] The authentication shall primarily use the primary RSN

Signed-off-by: jiazheng.yin <jiazheng.yin@gl-inet.com>
---
 wpa_supplicant/bss.c            | 14 +++++++--
 wpa_supplicant/events.c         | 19 ++++++++----
 wpa_supplicant/sme.c            |  2 ++
 wpa_supplicant/wpa_supplicant.c | 14 +++++++--
 wpa_supplicant/wpas_glue.c      | 51 ++++++++++++++++++++++-----------
 5 files changed, 73 insertions(+), 27 deletions(-)

diff --git a/wpa_supplicant/bss.c b/wpa_supplicant/bss.c
index 5c51a71..c2a8739 100644
--- a/wpa_supplicant/bss.c
+++ b/wpa_supplicant/bss.c
@@ -1459,13 +1459,18 @@ const u8 * wpa_bss_get_rsne(const struct wpa_bss *bss)
 		return wpa_bss_get_ie(bss, WLAN_EID_RSN);
 #endif /* CONFIG_TESTING_OPTIONS */
 
+	/* Prefer the main RSNE (Element ID 48) over any override vendor IE. */
+	ie = wpa_bss_get_ie(bss, WLAN_EID_RSN);
+	if (ie)
+		return ie;
+	
 	ie = wpa_bss_get_vendor_ie(bss, RSNE_OVERRIDE_2_IE_VENDOR_TYPE);
 	if (ie)
 		return ie;
 	ie = wpa_bss_get_vendor_ie(bss, RSNE_OVERRIDE_IE_VENDOR_TYPE);
 	if (ie)
 		return ie;
-	return wpa_bss_get_ie(bss, WLAN_EID_RSN);
+	return NULL;
 }
 
 
@@ -1478,9 +1483,14 @@ const u8 * wpa_bss_get_rsnxe(const struct wpa_bss *bss)
 		return wpa_bss_get_ie(bss, WLAN_EID_RSNX);
 #endif /* CONFIG_TESTING_OPTIONS */
 
+	/* Prefer the main RSNXE (Element ID 244) over any override vendor IE. */
+	ie = wpa_bss_get_ie(bss, WLAN_EID_RSNX);
+	if (ie)
+		return ie;
+
 	ie = wpa_bss_get_vendor_ie(bss, RSNXE_OVERRIDE_IE_VENDOR_TYPE);
 	if (ie)
 		return ie;
-	return wpa_bss_get_ie(bss, WLAN_EID_RSNX);
+	return NULL;
 }
 
diff --git a/wpa_supplicant/events.c b/wpa_supplicant/events.c
index d4a481f..8bd859a 100644
--- a/wpa_supplicant/events.c
+++ b/wpa_supplicant/events.c
@@ -2949,7 +2949,7 @@ static int wpa_supplicant_use_own_rsne_params(struct wpa_supplicant *wpa_s,
 static int wpa_supplicant_event_associnfo(struct wpa_supplicant *wpa_s,
 					  union wpa_event_data *data)
 {
-	int l, len, found = 0, found_x = 0, wpa_found, rsn_found;
+	int l, len, found = 0, found_x = 0, wpa_found, rsn_found, rsnx_found;
 	const u8 *p, *ie;
 	u8 bssid[ETH_ALEN];
 	bool bssid_known;
@@ -3216,7 +3216,7 @@ no_pfs:
 
 	/* Go through the IEs and make a copy of the WPA/RSN IEs, if present.
 	 */
-	wpa_found = rsn_found = 0;
+	wpa_found = rsn_found = rsnx_found = 0;
 	while (p && l >= 2) {
 		len = p[1] + 2;
 		if (len > l) {
@@ -3237,7 +3237,8 @@ no_pfs:
 			wpa_sm_set_ap_rsn_ie(wpa_s->wpa, p, len);
 		}
 
-		if (p[0] == WLAN_EID_VENDOR_SPECIFIC && p[1] >= 6 &&
+		if (!rsn_found &&
+		    p[0] == WLAN_EID_VENDOR_SPECIFIC && p[1] >= 6 &&
 		    WPA_GET_BE32(&p[2]) == RSNE_OVERRIDE_2_IE_VENDOR_TYPE) {
 			rsn_found = 1;
 			wpa_sm_set_ap_rsn_ie(wpa_s->wpa, p, len);
@@ -3250,12 +3251,18 @@ no_pfs:
 			wpa_sm_set_ap_rsn_ie(wpa_s->wpa, p, len);
 		}
 
-		if (p[0] == WLAN_EID_RSNX && p[1] >= 1)
+		if (!rsnx_found &&
+		    p[0] == WLAN_EID_RSNX && p[1] >= 1) {
+			rsnx_found = 1;
 			wpa_sm_set_ap_rsnxe(wpa_s->wpa, p, len);
+		}
 
-		if (p[0] == WLAN_EID_VENDOR_SPECIFIC && p[1] >= 6 &&
-		    WPA_GET_BE32(&p[2]) == RSNXE_OVERRIDE_IE_VENDOR_TYPE)
+		if (!rsnx_found &&
+		    p[0] == WLAN_EID_VENDOR_SPECIFIC && p[1] >= 6 &&
+		    WPA_GET_BE32(&p[2]) == RSNXE_OVERRIDE_IE_VENDOR_TYPE) {
+			rsnx_found = 1;
 			wpa_sm_set_ap_rsnxe(wpa_s->wpa, p, len);
+		}
 
 		l -= len;
 		p += len;
diff --git a/wpa_supplicant/sme.c b/wpa_supplicant/sme.c
index 51d92cb..51f9acf 100644
--- a/wpa_supplicant/sme.c
+++ b/wpa_supplicant/sme.c
@@ -2158,6 +2158,7 @@ mscs_fail:
 	}
 #endif /* CONFIG_TESTING_OPTIONS */
 	if (wpa_s->current_bss &&
+		!wpa_bss_get_ie(wpa_s->current_bss, WLAN_EID_RSN) &&
 	    wpa_bss_get_vendor_ie(wpa_s->current_bss,
 				  RSNE_OVERRIDE_2_IE_VENDOR_TYPE) &&
 	    wpa_s->sme.assoc_req_ie_len + 2 + 4 <=
@@ -2177,6 +2178,7 @@ mscs_fail:
 		wpa_printf(MSG_INFO,
 				   "support for RSN overriding 2");
 	} else if (wpa_s->current_bss &&
+		!wpa_bss_get_ie(wpa_s->current_bss, WLAN_EID_RSN) &&
 	    wpa_bss_get_vendor_ie(wpa_s->current_bss,
 				  RSNE_OVERRIDE_IE_VENDOR_TYPE) &&
 	    wpa_s->sme.assoc_req_ie_len + 2 + 4 <=
diff --git a/wpa_supplicant/wpa_supplicant.c b/wpa_supplicant/wpa_supplicant.c
index 1f1cce1..23b0d07 100644
--- a/wpa_supplicant/wpa_supplicant.c
+++ b/wpa_supplicant/wpa_supplicant.c
@@ -1573,6 +1573,13 @@ int wpa_supplicant_set_suites(struct wpa_supplicant *wpa_s,
 				bss, RSNE_OVERRIDE_2_IE_VENDOR_TYPE);
 			rsnxoe = wpa_bss_get_vendor_ie(
 				bss, RSNXE_OVERRIDE_IE_VENDOR_TYPE);
+			/* Prefer standard RSNE/RSNXE; ignore WFA overrides if present */
+			if (bss_rsn) {
+				rsnoe = NULL;
+				rsno2e = NULL;
+			}
+			if (bss_rsnx)
+				rsnxoe = NULL;
 		}
 
 		if (wpa_sm_set_ap_wpa_ie(wpa_s->wpa, bss_wpa,
@@ -3550,7 +3557,9 @@ mscs_end:
 	wpa_sm_set_param(wpa_s->wpa, WPA_PARAM_RSN_OVERRIDE,
 			 RSN_OVERRIDE_NOT_USED);
 
-	if (bss && wpa_bss_get_vendor_ie(bss, RSNE_OVERRIDE_2_IE_VENDOR_TYPE) &&
+	/* RSNE override vendor IEs apply only when there is no standard RSNE */
+	if (bss && !wpa_bss_get_ie(bss, WLAN_EID_RSN) &&
+	    wpa_bss_get_vendor_ie(bss, RSNE_OVERRIDE_2_IE_VENDOR_TYPE) &&
 	    wpa_ie_len + 2 + 4 <= max_wpa_ie_len) {
 		u8 *pos = wpa_ie + wpa_ie_len;
 
@@ -3565,7 +3574,8 @@ mscs_end:
 		*pos = RSN_SELECTION_RSNE_OVERRIDE_2;
 		wpa_ie_len += 2 + 4 + 1;
 		wpa_hexdump(MSG_MSGDUMP, "RSN Selection IE -2 ", wpa_ie, pos - wpa_ie);
-	} else if (bss && wpa_bss_get_vendor_ie(bss, RSNE_OVERRIDE_IE_VENDOR_TYPE) &&
+	} else if (bss && !wpa_bss_get_ie(bss, WLAN_EID_RSN) &&
+		wpa_bss_get_vendor_ie(bss, RSNE_OVERRIDE_IE_VENDOR_TYPE) &&
 	    wpa_ie_len + 2 + 4 <= max_wpa_ie_len) {
 		u8 *pos = wpa_ie + wpa_ie_len;
 
diff --git a/wpa_supplicant/wpas_glue.c b/wpa_supplicant/wpas_glue.c
index ece144a..97bf93b 100644
--- a/wpa_supplicant/wpas_glue.c
+++ b/wpa_supplicant/wpas_glue.c
@@ -417,33 +417,50 @@ static int wpa_get_beacon_ie(struct wpa_supplicant *wpa_s)
 	}
 
 	if (curr) {
+		const u8 *main_rsn;
+		const u8 *main_rsnx;
+
 		ie = wpa_bss_get_vendor_ie(curr, WPA_IE_VENDOR_TYPE);
 		if (wpa_sm_set_ap_wpa_ie(wpa_s->wpa, ie, ie ? 2 + ie[1] : 0))
 			ret = -1;
 
-		ie = wpa_bss_get_ie(curr, WLAN_EID_RSN);
-		if (wpa_sm_set_ap_rsn_ie(wpa_s->wpa, ie, ie ? 2 + ie[1] : 0))
-			ret = -1;
-
-		ie = wpa_bss_get_ie(curr, WLAN_EID_RSNX);
-		if (wpa_sm_set_ap_rsnxe(wpa_s->wpa, ie, ie ? 2 + ie[1] : 0))
+		main_rsn = wpa_bss_get_ie(curr, WLAN_EID_RSN);
+		if (wpa_sm_set_ap_rsn_ie(wpa_s->wpa, main_rsn,
+						main_rsn ? 2 + main_rsn[1] : 0))
 			ret = -1;
 
-		ie = wpa_bss_get_vendor_ie(curr, RSNE_OVERRIDE_IE_VENDOR_TYPE);
-		if (wpa_sm_set_ap_rsne_override(wpa_s->wpa, ie,
-						ie ? 2 + ie[1] : 0))
+		main_rsnx = wpa_bss_get_ie(curr, WLAN_EID_RSNX);
+		if (wpa_sm_set_ap_rsnxe(wpa_s->wpa, main_rsnx,
+					main_rsnx ? 2 + main_rsnx[1] : 0))
 			ret = -1;
 
-		ie = wpa_bss_get_vendor_ie(curr,
-					   RSNE_OVERRIDE_2_IE_VENDOR_TYPE);
-		if (wpa_sm_set_ap_rsne_override_2(wpa_s->wpa, ie,
-						  ie ? 2 + ie[1] : 0))
-			ret = -1;
+		if (!main_rsn) {
+			ie = wpa_bss_get_vendor_ie(curr,
+							RSNE_OVERRIDE_IE_VENDOR_TYPE);
+			if (wpa_sm_set_ap_rsne_override(wpa_s->wpa, ie,
+							ie ? 2 + ie[1] : 0))
+				ret = -1;
+
+			ie = wpa_bss_get_vendor_ie(
+				curr, RSNE_OVERRIDE_2_IE_VENDOR_TYPE);
+			if (wpa_sm_set_ap_rsne_override_2(wpa_s->wpa, ie,
+								ie ? 2 + ie[1] : 0))
+				ret = -1;
+		} else {
+			if (wpa_sm_set_ap_rsne_override(wpa_s->wpa, NULL, 0) ||
+				wpa_sm_set_ap_rsne_override_2(wpa_s->wpa, NULL, 0))
+				ret = -1;
+		}
 
-		ie = wpa_bss_get_vendor_ie(curr, RSNXE_OVERRIDE_IE_VENDOR_TYPE);
-		if (wpa_sm_set_ap_rsnxe_override(wpa_s->wpa, ie,
-						 ie ? 2 + ie[1] : 0))
+		if (!main_rsnx) {
+			ie = wpa_bss_get_vendor_ie(curr,
+							RSNXE_OVERRIDE_IE_VENDOR_TYPE);
+			if (wpa_sm_set_ap_rsnxe_override(wpa_s->wpa, ie,
+								ie ? 2 + ie[1] : 0))
+				ret = -1;
+		} else if (wpa_sm_set_ap_rsnxe_override(wpa_s->wpa, NULL, 0)) {
 			ret = -1;
+		}
 	} else {
 		ret = -1;
 	}
-- 
2.34.1

