+	rcu_read_lock();
+	list_for_each_entry(item, &p_muldf->module_head, list) {
+		if (!strcmp(item->name, module)) {
+			rcu_read_unlock();
+			return item;
+		}
+	}
+	rcu_read_unlock();
+
+	return NULL;
