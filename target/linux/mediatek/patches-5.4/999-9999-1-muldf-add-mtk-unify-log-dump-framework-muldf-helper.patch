+static u16 checksum16(u8 *buf, int len)
+{
+	int sum = 0;
+
+	while (len > 1) {
+		sum += *((u16 *)buf);
+
+		buf = buf + 2;
+
+		if (sum & 0x80000000)
+			sum = (sum & 0xFFFF) + (sum >> 16);
+		len -= 2;
+	}
+
+	if (len)
+		sum += *((u8 *)buf);
+
+	while (sum >> 16)
+		sum = (sum & 0xFFFF) + (sum >> 16);
+
+	return ~sum;
+}
+
+static inline bool is_str_empty(const char *str)
+{
+	return (!str || (str[0] == '\0'));
+}
+
+static inline bool is_str_valid(const char *str)
+{
+	return !(is_str_empty(str) || strlen(str) >= MAX_NAME_LEN);
+}
+
+static inline void str_empty_handle(char **p_str, char *str)
+{
+	*p_str = is_str_empty(str) ? MULDF_INVALID_STR : str;
+}
+
+int muldf_helper_get_local_mac(void)
+{
+	struct net_device *netdev = NULL;
+	struct net *net = &init_net;
+
+	for_each_netdev(net, netdev) {
+		if (!strcmp(netdev->name, "br-lan")) {
+			memcpy(p_muldf->local_mac, netdev->dev_addr, ETH_ALEN);
+
+			/* fake a source address for transmission */
+			if (p_muldf->local_mac[1] == 0xff)
+				p_muldf->local_mac[1] = 0;
+			else
+				p_muldf->local_mac[1] += 64;
+
+			return 0;
+		}
+	}
+
+	return -1;
+}
+
+static bool muldf_helper_event_status(u16 event_id)
+{
+	struct muldf_event_entry *item;
+	unsigned long flags;
+
+	if (p_muldf->enable == MTK_EVENT_DISABLED)
+		return false;
+
+	if (p_muldf->enable == MTK_EVENT_ENABLED_ALL)
+		return true;
+
+	spin_lock_irqsave(&p_muldf->event_entry_lock, flags);
+	list_for_each_entry(item, &p_muldf->event_entry_head, list) {
+		if (item->id == event_id) {
+			spin_unlock_irqrestore(&p_muldf->event_entry_lock, flags);
+			return true;
+		}
+	}
+	spin_unlock_irqrestore(&p_muldf->event_entry_lock, flags);
+
+	return false;
+}
+
+int muldf_helper_add_event(u16 id)
+{
+	struct muldf_event_entry *entry;
+	unsigned long flags;
+
+	entry = kmalloc(sizeof(*entry), GFP_KERNEL);
+	if (!entry)
+		return -1;
+
+	entry->id = id;
+	INIT_LIST_HEAD(&entry->list);
+
+	spin_lock_irqsave(&p_muldf->event_entry_lock, flags);
+
+	if (p_muldf->event_entry_num > EVENT_ID_MAX_NUM) {
+		spin_unlock_irqrestore(&p_muldf->event_entry_lock, flags);
+		list_del(&entry->list);
+		kfree(entry);
+		return -1;
+	}
+	list_add(&entry->list, &p_muldf->event_entry_head);
+	p_muldf->event_entry_num++;
+
+	spin_unlock_irqrestore(&p_muldf->event_entry_lock, flags);
+
+	return 0;
+}
+
+int muldf_helper_del_event(void)
+{
+	struct muldf_event_entry *item, *tmp;
+	unsigned long flags;
+
+	spin_lock_irqsave(&p_muldf->event_entry_lock, flags);
+	list_for_each_entry_safe(item, tmp, &p_muldf->event_entry_head, list) {
+		list_del(&item->list);
+		kfree(item);
+	}
+	spin_unlock_irqrestore(&p_muldf->event_entry_lock, flags);
+
+	return 0;
+}
+
+static int muldf_helper_enq_event(struct muldf_event_hdr *ev)
+{
+	struct muldf_event_queue *q = &p_muldf->event_queue;
+	unsigned long flags;
+
+	spin_lock_irqsave(&q->lock, flags);
+
+	if ((q->tail + 1) % MAX_EVENT_CNT == q->head) {
+		spin_unlock_irqrestore(&q->lock, flags);
+		return -1;
+	}
+
+	q->events[q->tail] = *ev;
+	q->tail = (q->tail + 1) % MAX_EVENT_CNT;
+	q->cnt++;
+	q->total_cnt++;
+
+	atomic_set(&p_muldf->event_queue_status, 1);
+	wake_up_interruptible(&p_muldf->event_queue_wait);
+
+	spin_unlock_irqrestore(&q->lock, flags);
+
+	return 0;
+}
+
+int muldf_helper_deq_event(struct muldf_event_hdr *ev)
+{
+	struct muldf_event_queue *q = &p_muldf->event_queue;
+	unsigned long flags;
+
+	spin_lock_irqsave(&q->lock, flags);
+
+	if (q->head == q->tail) {
+		spin_unlock_irqrestore(&q->lock, flags);
+		return -1;
+	}
+
+	*ev = q->events[q->head];
+	q->head = (q->head + 1) % MAX_EVENT_CNT;
+	q->cnt--;
+
+	if (q->head == q->tail)
+		atomic_set(&p_muldf->event_queue_status, 0);
+
+	spin_unlock_irqrestore(&q->lock, flags);
+
+	return 0;
+}
