+
+static struct muldf_module *muldf_helper_check(char *module, char *cat, char *sub_cat, u8 *dump)
+{
+	struct muldf_module *p_mod;
+	struct muldf_cat *p_cat;
+	struct muldf_sub_cat *p_sub_cat;
+
+	// check module
+	p_mod = muldf_helper_get_module(module);
+	if (!p_mod)
+		return NULL;
+
+	/* we allow module print without category,
+	 * but, we not allow module print without wrong category
+	 */
+	if (is_str_empty(cat))
+		return p_mod;
+
+	p_cat = muldf_helper_get_cat(p_mod, cat);
+	if (!p_cat)
+		return NULL;
+
+	/* we allow module print without sub category,
+	 * but, we not allow module print without wrong sub category
+	 */
+	if (is_str_empty(sub_cat))
+		return p_mod;
+
+	p_sub_cat = muldf_helper_get_sub_cat(p_cat, sub_cat);
+	if (!p_sub_cat)
+		return NULL;
+
+	if (dump)
+		*dump = p_sub_cat->pkt_dump && p_sub_cat->pkt_dump_en;
+
+	return p_mod;
+}
+
+int muldf_helper_set_module_level(char *module, u8 level)
+{
+	struct muldf_module *p_mod = NULL;
+	unsigned long flags;
+
+	if (level > MTK_MSG_ERROR)
+		return -1;
+
+	if (!is_str_valid(module))
+		return -1;
+
+	spin_lock_irqsave(&p_muldf->module_lock, flags);
+	list_for_each_entry(p_mod, &p_muldf->module_head, list) {
+		if (!strcmp(p_mod->name, module)) {
+			p_mod->debug_level = level;
+			spin_unlock_irqrestore(&p_muldf->module_lock, flags);
+			return 0;
+		}
+	}
+	spin_unlock_irqrestore(&p_muldf->module_lock, flags);
+
+	return -1;
+}
+
+int muldf_helper_set_module_cat_dump(char *module, char *cat, char *sub_cat, u8 dump_en)
+{
+	struct muldf_module *p_mod = NULL;
+	struct muldf_cat *p_cat = NULL;
+	struct muldf_sub_cat *p_sub_cat = NULL;
+	unsigned long flags;
+
+	if (!is_str_valid(sub_cat))
+		return -1;
+
+	p_mod = muldf_helper_get_module(module);
+	if (!p_mod)
+		return -1;
+
+	p_cat = muldf_helper_get_cat(p_mod, cat);
+	if (!p_cat)
+		return -1;
+
+	spin_lock_irqsave(&p_muldf->module_lock, flags);
+	list_for_each_entry(p_sub_cat, &p_cat->sub_cat_head, list) {
+		if (!strcmp(p_sub_cat->name, sub_cat)) {
+			if (p_sub_cat->pkt_dump != MTK_DUMP_NONE)
+				p_sub_cat->pkt_dump_en = dump_en;
+
+			spin_unlock_irqrestore(&p_muldf->module_lock, flags);
+			return 0;
+		}
+	}
+	spin_unlock_irqrestore(&p_muldf->module_lock, flags);
+
+	return -1;
+}
+
+int muldf_helper_get_module_info(void)
+{
+	struct sub_cat_t {
+		char name[MAX_NAME_LEN];
+		u8 dump;
+		u8 dump_en;
+	};
+	struct cat_t {
+		char name[MAX_NAME_LEN];
+		u8 sub_cat_num;
+		u8 sub_cat[];
+	};
+	struct module_t {
+		char name[MAX_NAME_LEN];
+		u8 debug_level;
+		u8 cat_num;
+		u8 cat[];
+	};
+
+	struct muldf_module *p_mod;
+	struct muldf_cat *p_cat;
+	struct muldf_sub_cat *p_sub_cat;
+	int module_idx = 0;
+
+	rcu_read_lock();
+	list_for_each_entry(p_mod, &p_muldf->module_head, list) {
+		struct module_t *module = NULL;
+		u16 len = 0, cat_len = 0;
+		u8 *data;
+		struct {
+			u16 module_idx;
+			u16 len;
+		} __packed hdr;
+
+		list_for_each_entry(p_cat, &p_mod->cat_head, list) {
+			len += (sizeof(struct cat_t) +
+			       p_cat->sub_cat_num * sizeof(struct sub_cat_t));
+		}
+
+		len += sizeof(struct module_t);
+		data = kmalloc(len, GFP_KERNEL);
+		if (!data) {
+			rcu_read_unlock();
+			return -1;
+		}
+
+		memset(data, 0, len);
+		module = (struct module_t *)data;
+		strcpy(module->name, p_mod->name);
+		module->debug_level = p_mod->debug_level;
+		module->cat_num = p_mod->cat_num;
+
+		list_for_each_entry(p_cat, &p_mod->cat_head, list) {
+			struct cat_t *cat = (struct cat_t *)(module->cat + cat_len);
+			int k = 0;
+
+			strcpy(cat->name, p_cat->name);
+			cat->sub_cat_num = p_cat->sub_cat_num;
+			cat_len += (sizeof(struct cat_t) +
+				   (p_cat->sub_cat_num * sizeof(struct sub_cat_t)));
+
+			list_for_each_entry(p_sub_cat, &p_cat->sub_cat_head, list) {
+				struct sub_cat_t *sub_cat;
+				u16 sub_cat_len = k * sizeof(struct sub_cat_t);
+
+				sub_cat = (struct sub_cat_t *)(cat->sub_cat + sub_cat_len);
+				strcpy(sub_cat->name, p_sub_cat->name);
+				sub_cat->dump = p_sub_cat->pkt_dump;
+				sub_cat->dump_en = p_sub_cat->pkt_dump_en;
+				k++;
+			}
+		}
+
+		hdr.len = len;
+		hdr.module_idx = module_idx++;
+
+		__muldf_helper_xmit_with_hdr(MTK_PKT_MODULE_INFO, (u8 *)&hdr,
+					     sizeof(hdr), data, len);
+	}
+	rcu_read_unlock();
+
+	return 0;
+}
+
+// API export
+void muldf_xmit_ics(const u8 *data, u16 len)
+{
+	struct muldf_ics_hdr hdr = {0};
+
+	if (p_muldf->mode == MTK_MODE_INTERNAL)
+		return;
+
+	hdr.magic = ICS_DUMP_MAGIC;
+	hdr.len = len;
+
+	__muldf_helper_xmit_with_hdr(MTK_PKT_WLAN_ICS, (u8 *)&hdr, sizeof(hdr), data, len);
+}
+EXPORT_SYMBOL(muldf_xmit_ics);
+
+void muldf_xmit_fwlog(const u8 *data, u16 len)
+{
+	struct muldf_ics_hdr hdr = {0};
+
+	if (p_muldf->mode == MTK_MODE_INTERNAL)
+		return;
+
+	hdr.magic = FWLOG_DUMP_MAGIC;
+	hdr.len = len;
+
+	__muldf_helper_xmit_with_hdr(MTK_PKT_WLAN_FWLOG, (u8 *)&hdr, sizeof(hdr), data, len);
+}
+EXPORT_SYMBOL(muldf_xmit_fwlog);
+
+u64 muldf_alloc_pid(void)
+{
+	p_muldf->pid++;
+	if (!p_muldf->pid)
+		p_muldf->pid++;
+
+	return p_muldf->pid;
+}
+EXPORT_SYMBOL(muldf_alloc_pid);
+
+void muldf_xmit_pkt(u64 pid, const u8 *data, u16 len)
+{
+	struct muldf_pkt_hdr hdr = {0};
+
+	if (p_muldf->mode == MTK_MODE_INTERNAL)
+		return;
+
+	hdr.pid = pid;
+	hdr.len = len;
+	hdr.magic = PKT_DUMP_MAGIC;
+
+	__muldf_helper_xmit_with_hdr(MTK_PKT_RAW_DATA, (u8 *)&hdr, sizeof(hdr), data, len);
+}
+EXPORT_SYMBOL(muldf_xmit_pkt);
+
+void muldf_xmit_event(u16 id)
+{
+	/* we sent the event to userspace,
+	 * so that user filter the special event
+	 */
+	if (p_muldf->mode == MTK_MODE_INTERNAL) {
+		struct muldf_event_hdr event;
+
+		if (!p_muldf->attach)
+			return;
+
+		event.event_id = id;
+		event.magic = EVENT_MAGIC;
+		muldf_helper_enq_event(&event);
+
+	// pc-tool mode, we sent event to pc-tool.
+	} else if (p_muldf->mode == MTK_MODE_PC) {
+		struct sk_buff *skb = NULL;
+		struct muldf_event_hdr hdr = {0};
+		bool enable  = muldf_helper_event_status(id);
+
+		if (enable) {
+			/* 802.3 + IP + UDP + dbg */
+			int header_len = LEN_802_3_H + LEN_IPV4_H + LEN_UDP_H
+					+ sizeof(struct muldf_hdr);
+			int len = sizeof(hdr);
+			bool is_padding = false;
+			u8 *data;
+
+			if ((len % 2) != 0) {
+				len += 1;
+				is_padding = true;
+			}
+
+			skb = muldf_helper_alloc(header_len + len);
+			if (!skb)
+				return;
+
+			memset(skb->head, 0, header_len + len);
+
+			skb_reserve(skb, header_len);
+			/* prepare event header */
+			hdr.event_id = id;
+			hdr.magic = EVENT_MAGIC;
+
+			data  = skb_put_data(skb, &hdr, sizeof(hdr));
+			if (is_padding)
+				*(data + sizeof(hdr)) = 0;
+
+			/* send event */
+			__muldf_helper_xmit(MTK_PKT_EVENT, skb,
+					    sizeof(struct muldf_hdr) + len);
+		}
+	}
+}
+EXPORT_SYMBOL(muldf_xmit_event);
+
+int muldf_add_module(char *module, int def_level)
+{
+	struct muldf_module *p_mod;
+	unsigned long flags;
+
+	if (def_level > MTK_MSG_ERROR)
+		return -1;
+
+	if (!is_str_valid(module))
+		return -1;
+
+	// no resource available, return error
+	if (p_muldf->module_num >= MAX_MODULE)
+		return -1;
+
+	// check whether module already registered
+	p_mod = muldf_helper_get_module(module);
+	if (p_mod)
+		return -1;
+
+	p_mod = kmalloc(sizeof(*p_mod), GFP_KERNEL);
+	if (!p_mod)
+		return -1;
+
+	strncpy(p_mod->name, module, MAX_NAME_LEN);
+	p_mod->debug_level = def_level;
+	p_mod->cat_num = 0;
+	INIT_LIST_HEAD(&p_mod->cat_head);
+	INIT_LIST_HEAD(&p_mod->list);
+
+	spin_lock_irqsave(&p_muldf->module_lock, flags);
+	list_add(&p_mod->list, &p_muldf->module_head);
+	spin_unlock_irqrestore(&p_muldf->module_lock, flags);
+
+	p_muldf->module_num++;
+
+	return 0;
+}
+EXPORT_SYMBOL(muldf_add_module);
+
+int muldf_del_module(char *module)
+{
+	struct muldf_module *p_mod = NULL, *tmp_mod;
+	struct muldf_cat *p_cat, *tmp_cat;
+	struct muldf_sub_cat *p_sub_cat, *tmp_sub_cat;
+
+	if (!is_str_valid(module))
+		return -1;
+
+	rcu_read_lock();
+	list_for_each_entry_safe(p_mod, tmp_mod, &p_muldf->module_head, list) {
+		if (!strcmp(p_mod->name, module)) {
+			list_del(&p_mod->list);
+
+			list_for_each_entry_safe(p_cat, tmp_cat, &p_mod->cat_head, list) {
+				list_del(&p_cat->list);
+
+				list_for_each_entry_safe(p_sub_cat, tmp_sub_cat, &p_cat->sub_cat_head, list) {
+					list_del(&p_sub_cat->list);
+					kfree(p_sub_cat);
+				}
+
+				kfree(p_cat);
+			}
+			kfree(p_mod);
+			break;
+		}
+	}
+	rcu_read_unlock();
+
+	return 0;
+}
+EXPORT_SYMBOL(muldf_del_module);
+
+int muldf_add_cat(char *module, char *cat)
+{
+	struct muldf_module *p_mod;
+	struct muldf_cat *p_cat;
+	unsigned long flags;
+
+	if (!is_str_valid(cat))
+		return -1;
+
+	p_mod = muldf_helper_get_module(module);
+	if (!p_mod)
+		return -1;
+
+	// no resource available, return error
+	if (p_mod->cat_num >= MAX_CATEGORY)
+		return -1;
+
+	// check whether category already added
+	p_cat = muldf_helper_get_cat(p_mod, cat);
+	if (p_cat)
+		return -1;
+
+	p_cat = kmalloc(sizeof(*p_cat), GFP_KERNEL);
+	if (!p_cat)
+		return -1;
+
+	strncpy(p_cat->name, cat, MAX_NAME_LEN);
+	p_cat->sub_cat_num = 0;
+	INIT_LIST_HEAD(&p_cat->sub_cat_head);
+	INIT_LIST_HEAD(&p_cat->list);
+
+	spin_lock_irqsave(&p_muldf->module_lock, flags);
+	list_add(&p_cat->list, &p_mod->cat_head);
+	spin_unlock_irqrestore(&p_muldf->module_lock, flags);
+
+	p_mod->cat_num++;
+
+	return 0;
+}
+EXPORT_SYMBOL(muldf_add_cat);
+
+int muldf_add_sub_cat(char *module, char *cat, char *sub_cat, u8 pkt_dump)
+{
+	struct muldf_module *p_mod;
+	struct muldf_cat *p_cat;
+	struct muldf_sub_cat *p_sub_cat;
+	unsigned long flags;
+
+	if (!is_str_valid(sub_cat))
+		return -1;
+
+	p_mod = muldf_helper_get_module(module);
+	if (!p_mod)
+		return -1;
+
+	p_cat = muldf_helper_get_cat(p_mod, cat);
+	if (!p_cat)
+		return -1;
+
+	// no resource available, return error
+	if (p_cat->sub_cat_num >= MAX_SUB_CATEGORY)
+		return -1;
+
+	// check whether sub category is already added
+	p_sub_cat = muldf_helper_get_sub_cat(p_cat, sub_cat);
+	if (p_sub_cat)
+		return -1;
+
+	p_sub_cat = kmalloc(sizeof(*p_sub_cat), GFP_KERNEL);
+	if (!p_sub_cat)
+		return -1;
+
+	strncpy(p_sub_cat->name, sub_cat, MAX_NAME_LEN);
+	p_sub_cat->pkt_dump = pkt_dump;
+	p_sub_cat->pkt_dump_en = 0;
+	INIT_LIST_HEAD(&p_sub_cat->list);
+
+	spin_lock_irqsave(&p_muldf->module_lock, flags);
+	list_add(&p_sub_cat->list, &p_cat->sub_cat_head);
+	spin_unlock_irqrestore(&p_muldf->module_lock, flags);
+
+	p_cat->sub_cat_num++;
+
+	return 0;
+}
+EXPORT_SYMBOL(muldf_add_sub_cat);
+
+void muldf_print(int level, char *module,
+		 char *cat, char *sub_cat, char *tag,
+		 const char *func, const u32 line,
+		 const char *fmt, ...)
+{
+	va_list args;
+	char *p_cat, *p_sub_cat, *p_tag, cbuf[MULDF_MAX_PRINT_LEN];
+	struct muldf_module *p_mod = muldf_helper_check(module, cat, sub_cat, NULL);
+	u16 cbuf_len;
+	u16 total_len = sizeof(cbuf);
+	u16 prefix_len = 0;
+
+	if (!p_mod)
+		return;
+
+	if (level < p_mod->debug_level)
+		return;
+
+	str_empty_handle(&p_cat, cat);
+	str_empty_handle(&p_sub_cat, sub_cat);
+	str_empty_handle(&p_tag, tag);
+
+	if (func)
+		prefix_len = snprintf(cbuf, total_len, "%s %d:", func, line);
+
+	va_start(args, fmt);
+	vsnprintf(cbuf + prefix_len, total_len - prefix_len, fmt, args);
+	va_end(args);
+
+	cbuf_len = strlen(cbuf) + 1;
+	muldf_helper_print(level, module, 0, p_cat, p_sub_cat, p_tag, cbuf, cbuf_len);
+}
+EXPORT_SYMBOL(muldf_print);
+
+void muldf_print_hex(int level, char *module,
+		     char *cat, char *sub_cat, char *tag,
+		     u8 *buf, u16 len, const char *title)
+{
+	char *p_cat, *p_sub_cat, *p_tag;
+	struct muldf_module *p_mod = muldf_helper_check(module, cat, sub_cat, NULL);
+
+	if (!p_mod)
+		return;
+
+	if (level < p_mod->debug_level)
+		return;
+
+	str_empty_handle(&p_cat, cat);
+	str_empty_handle(&p_sub_cat, sub_cat);
+	str_empty_handle(&p_tag, tag);
+
+	muldf_helper_print_hex(level, module, p_cat, p_sub_cat, p_tag, buf, len, title);
+}
+EXPORT_SYMBOL(muldf_print_hex);
+
+void muldf_print_pkt(int level, char *module,
+		     char *cat, char *sub_cat, char *tag,
+		     u8 *buf, u16 len, const char *fmt, ...)
+{
+	u64 pid;
+	u8 dump = 0;
+	char *p_cat, *p_sub_cat, *p_tag, cbuf[MULDF_MAX_PRINT_LEN];
+	va_list args;
+	struct muldf_module *p_mod = muldf_helper_check(module, cat, sub_cat, &dump);
+	u16 cbuf_len;
+
+	if (!p_mod)
+		return;
+
+	if (level < p_mod->debug_level)
+		return;
+
+	// [key, value] = [skb's address, pid]
+	// TODO: record more info to filter the same packet
+	if (dump) {
+		pid = muldf_alloc_pid();
+
+		str_empty_handle(&p_cat, cat);
+		str_empty_handle(&p_sub_cat, sub_cat);
+		str_empty_handle(&p_tag, tag);
+
+		va_start(args, fmt);
+		vsnprintf(cbuf, sizeof(cbuf), fmt, args);
+		va_end(args);
+
+		cbuf_len = strlen(cbuf) + 1;
+		muldf_helper_print(level, module, pid, p_cat, p_sub_cat, p_tag, cbuf, cbuf_len);
+
+		if (len > 0)
+			muldf_xmit_pkt(pid, buf, len);
+	}
+}
+EXPORT_SYMBOL(muldf_print_pkt);
+
+static int __init muldf_hepler_init(void)
+{
+	int ret = 0;
+	u8 def_mac[ETH_ALEN] = {0x00, 0x01, 0x02, 0x03, 0x04, 0x05};
+
+	p_muldf = kzalloc(sizeof(*p_muldf), GFP_KERNEL);
+	if (!p_muldf)
+		return -ENOMEM;
+
+	memset(p_muldf, 0, sizeof(struct muldf_helper));
+	ret = muldf_helper_vnet_init();
+	if (ret)
+		goto err;
+
+	INIT_LIST_HEAD(&p_muldf->module_head);
+	spin_lock_init(&p_muldf->module_lock);
+
+	INIT_LIST_HEAD(&p_muldf->event_entry_head);
+	spin_lock_init(&p_muldf->event_entry_lock);
+	spin_lock_init(&p_muldf->event_queue.lock);
+	init_waitqueue_head(&p_muldf->event_queue_wait);
+	atomic_set(&p_muldf->event_queue_status, 0);
+
+	// default, internal handle mode & allow event to userspace daemon
+	p_muldf->mode = MTK_MODE_INVALID;
+	scnprintf(p_muldf->platform, sizeof(p_muldf->platform), "mt7987");
+	scnprintf(p_muldf->wlan_driver, sizeof(p_muldf->wlan_driver), "logan");
+	scnprintf(p_muldf->wifi_chip, sizeof(p_muldf->wifi_chip), "mt7993");
+	p_muldf->enable = MTK_EVENT_ENABLED_ALL;
+
+	// default pc-tool server ip & port
+	memcpy(p_muldf->server_mac, def_mac, ETH_ALEN);
+	p_muldf->server_ip = 0x00000000;
+	p_muldf->server_port = PC_SERVER_DEF_PORT;
+	// default local mac, derived form br-lan
+	scnprintf(p_muldf->local_ifname, sizeof(p_muldf->local_ifname), "br-lan");
+
+	ret = muldf_helper_init_debugfs(p_muldf);
+	if (ret)
+		goto err_vnet;
+
+	return 0;
+
+err_vnet:
+	muldf_helper_vnet_exit();
+
+err:
+	kfree(p_muldf);
+	return ret;
+}
+
+static void __exit muldf_hepler_exit(void)
+{
+	muldf_helper_del_event();
+
+	muldf_helper_vnet_exit();
+
+	kfree(p_muldf);
+}
+
+module_init(muldf_hepler_init);
+module_exit(muldf_hepler_exit);
