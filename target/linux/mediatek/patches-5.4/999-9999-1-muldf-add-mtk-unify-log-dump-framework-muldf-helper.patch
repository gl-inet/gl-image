+
+// muldfd_cli's port for muldfd's ctrl server connect.
+#define CTRL_SERVER_LOCAL_PORT		(PC_SERVER_DEF_PORT + 4)
+
+// muldfd's port for pc-tool server connect.
+#define PC_SERVER_MULDFD_LOCAL_PORT	(PC_SERVER_DEF_PORT + 5)
+
+// mkt_uldf_helper's default ip/port for pc-tool server connect.
+#define PC_SERVER_IP			"192.168.1.2"
+#define PC_SERVER_DEF_PORT		9527
+#define PC_SERVER_DEF_PORT_MULDFD	(PC_SERVER_DEF_PORT + 1)
+#define PC_SERVER_MULDFH_LOCAL_PORT	(PC_SERVER_DEF_PORT + 2)
+
+#define P_802_3_TYPE		2
+#define LEN_802_3_H		14
+#define LEN_UDP_H		8
+#define LEN_IPV4_H		20
+
+#define EVENT_ID_MAX_NUM	512
+#define EVENT_MAGIC		0xabab
+#define PKT_DUMP_MAGIC		0xcdcd
+#define ICS_DUMP_MAGIC		0xefef
+#define FWLOG_DUMP_MAGIC	0xdfdf
+
+#define MAX_NAME_LEN		32
+#define MAX_MODULE		5
+#define MAX_CATEGORY		20
+#define MAX_SUB_CATEGORY	20
+#define MAX_EVENT_CNT		256
+
+// Specially defined event ID for internal muldf-helper use.
+#define EVENT_ID_MODE_INTERNAL	1999
+#define EVENT_ID_MODE_PC	1998
+#define EVENT_ID_DRIVER_INFO	1997
+
+#define MULDF_INVALID_STR	"null"
+
+enum muldf_pkt_type {
+	MTK_PKT_MODULE_INFO = 0xb000,
+	MTK_PKT_EVENT = 0xb001,
+	MTK_PKT_WLAN_ICS,
+	MTK_PKT_RAM_DUMP,
+	MTK_PKT_RAW_DATA,
+	MTK_PKT_KERNEL_LOG,
+	MTK_PKT_SYSTEM_LOG,
+	MTK_PKT_WLAN_FWLOG,
+	MTK_PKT_MCU_COREDUMP
+};
+
+enum muldf_event_en {
+	MTK_EVENT_DISABLED = 0,
+	MTK_EVENT_ENABLED_BY_EID,
+	MTK_EVENT_ENABLED_ALL,
+	_MTK_EVENT_ENABLED_MAX
+};
+
+enum muldf_mode {
+	MTK_MODE_INVALID = 0,
+	MTK_MODE_INTERNAL,
+	MTK_MODE_PC,
+	_MTK_MODE_MAX
+};
+
+struct muldf_hdr {
+	u32 ver; /*0x0*/
+	u16 type;
+	u16 frag_num;
+	u32 rsv[4];
+};
+
+struct muldf_event_hdr {
+	u16 event_id;
+	u16 magic;  /* 0xabab */
+	u32 rsv[4];
+};
+
+struct muldf_ics_hdr {
+	u16 magic;  /* 0xefef */
+	u16 len;
+	u32 rsv[4];
+};
+
+struct muldf_pkt_hdr {
+	u64 pid;
+	u16 magic;  /* 0xcdcd */
+	u16 len;
+	u32 rsv[4];
+};
+
+struct pseudo_header {
+	u32 saddr;
+	u32 daddr;
+	u16 len;
+	u16 protocol;
+};
+
+struct muldf_event_queue {
+	struct muldf_event_hdr events[MAX_EVENT_CNT];
+	int head;
+	int tail;
+	int cnt;
+	int total_cnt;
+	// lock to protect access to the event queue
+	spinlock_t lock;
+};
+
+struct muldf_event_entry {
+	u16 id;
+	u16 enable;
+	struct list_head list;
+};
+
+struct muldf_sub_cat {
+	char name[MAX_NAME_LEN];
+	u8 pkt_dump;
+	u8 pkt_dump_en;
+	struct list_head list;
+};
+
+struct muldf_cat {
+	char name[MAX_NAME_LEN];
+	u8 sub_cat_num;
+	struct list_head sub_cat_head;
+	struct list_head list;
+};
+
+struct muldf_module {
+	char name[MAX_NAME_LEN];
+	u8 debug_level;
+	u8 cat_num;
+	struct list_head cat_head;
+	struct list_head list;
+};
+
+struct muldf_helper {
+	u8 mode;
+	u64 pid;
+	// for common part
+	char platform[16];    // platform/apsoc name: mt7988/mt7986....
+	char wlan_driver[16]; // wifi driver name: logan/mt76/none
+	char wifi_chip[16];   // wifi chip name: mt7986/mt7990/mt7992....
+	char local_ifname[16];
+	u8 local_mac[ETH_ALEN];
+	u8 module_num;
+	// module_lock to protect access to muldf moudle
+	spinlock_t module_lock;
+	struct list_head module_head;
+	struct net_device *vnet;
+	// for pc daemon
+	u32 server_ip;
+	u16 server_port;
+	u8 server_mac[ETH_ALEN];
+	// for local userspace daemon
+	struct muldf_event_queue event_queue;
+	wait_queue_head_t event_queue_wait;
+	atomic_t event_queue_status;
+	char uuid[64];
+	char url[128];
+	u8 mac[ETH_ALEN];
+	u8 attach;
+	// for event info records
+	u8 enable;
+	u16 event_entry_num;
+	struct list_head event_entry_head;
+	// event_entry_lock to protect access to the event entry
+	spinlock_t event_entry_lock;
+};
+
+extern struct muldf_helper *p_muldf;
+
+int muldf_helper_vnet_init(void);
+int muldf_helper_vnet_exit(void);
+
+int muldf_helper_get_local_mac(void);
+int muldf_helper_get_module_info(void);
+int muldf_helper_set_module_level(char *module, u8 level);
+int muldf_helper_set_module_cat_dump(char *module, char *cat, char *sub_cat, u8 dump_en);
+
+int muldf_helper_init_debugfs(struct muldf_helper *p_muldf);
+int muldf_helper_add_event(u16 id);
+int muldf_helper_del_event(void);
+int muldf_helper_deq_event(struct muldf_event_hdr *ev);
+
+void muldf_helper_print(int level, char *module, u64 pid,
+			char *cat, char *sub_cat, char *tag,
+			char *buf, u16 len);
+void muldf_helper_print_hex(int level, char *module,
+			    char *cat, char *sub_cat, char *tag,
+			    u8 *buf, u16 len, const char *title);
+
+#endif /* __MULDF_HELPER_H */
diff --git a/net/muldf_helper/trace.c b/net/muldf_helper/trace.c
new file mode 100644
index 0000000..db2e1d2
--- /dev/null
+++ b/net/muldf_helper/trace.c
@@ -0,0 +1,124 @@
+// SPDX-License-Identifier: ISC
+/* Copyright (C) 2024 MediaTek Inc. */
+
+#include "linux/string.h"
+#include <linux/module.h>
+
+#ifndef __CHECKER__
+#define CREATE_TRACE_POINTS
+#include "trace.h"
+#include "muldf_helper.h"
+
+#define MULDF_DIV_ROUND_UP(n, d) (((n) + (d) - 1) / (d))
+
+#define	MULDF_HEX_FORMAT	" %02x"
+#define	MULDF_HEX_HEAD_FORMAT	"\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t %02x"
+#define	MULDF_HEX_TAIL_FORMAT	" %02x\n"
+#define	MULDF_TIMESTAMP_SIZE	64
+
+static char timestamp[MULDF_TIMESTAMP_SIZE];
+static u64 last_jiffies = 0;
+
+void muldf_helper_get_timestamp(void)
+{
+	struct timespec64 ts;
+	struct tm tm;
+	u64 now = jiffies, interval = HZ;
+	char *weekdays[] = {"Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"};
+	char *months[] = {"Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"};
+
+	if (time_after(now, last_jiffies + interval)) {
+		ktime_get_real_ts64(&ts);
+		time64_to_tm(ts.tv_sec, 0, &tm);
+
+		snprintf(timestamp, MULDF_TIMESTAMP_SIZE, "%s %s %02d %02d:%02d:%02d %04ld",
+			 weekdays[tm.tm_wday],
+			 months[tm.tm_mon],
+			 tm.tm_mday,
+			 tm.tm_hour, tm.tm_min, tm.tm_sec,
+			 tm.tm_year + 1900);
+
+		last_jiffies = now;
+	}
+}
+
+void muldf_helper_print(int level, char *module, u64 pid,
+			char *cat, char *sub_cat, char *tag,
+			char *buf, u16 len)
+{
+	muldf_helper_get_timestamp();
+
+	if (pid)
+		MULDF_PRINT_PID(timestamp, module, cat, sub_cat, tag, buf, len, pid);
+	else
+		MULDF_PRINT(timestamp, module, cat, sub_cat, tag, buf, len);
+}
+
+void muldf_helper_print_hex(int level, char *module,
+			    char *cat, char *sub_cat, char *tag,
+			    u8 *buf, u16 len, const char *title)
+{
+	u16 i, total_len;
+	const char *display = "";
+	char *strbuf = NULL;
+
+	if (!buf) {
+		display = " [NULL]";
+	} else if (len == 0) {
+		display = "";
+	} else if (len) {
+		u16 head, total, row, row_start, row_end;
+		char strhead[MULDF_MAX_PRINT_LEN];
+
+		snprintf(strhead, sizeof(strhead), "%s - hexdump(len=%d):\n", title, len);
+		head = strlen(strhead);
+		row = MULDF_DIV_ROUND_UP(len, 16);
+
+		/* total lenth calculate:
+		 * head + 1: header string
+		 * len * 3: byte expand to ' %02'
+		 * row: add '\n' on each row
+		 * row * 15: add the '\t' on each row
+		 */
+		total = (head + 1) + (3 * len) + (row) + (row * 15);
+		if (total >= MULDF_MAX_HEX_PRINT_LEN) {
+			display = " [hexdump, len is too large]";
+		} else {
+			strbuf = kmalloc(total, GFP_KERNEL);
+			if (!strbuf)
+				return;
+
+			snprintf(strbuf, (head + 1), "%s", strhead);
+			for (i = 0, row_start = 0, row_end = 0; i < len; i++) {
+				int mod = i % 16, offset;
+
+				offset = head + row_end + i * 3 + (row_start * 15);
+				switch (mod) {
+				case 0:
+					snprintf(&strbuf[offset], 19, MULDF_HEX_HEAD_FORMAT,
+						 buf[i]);
+					row_start++;
+					break;
+				case 15:
+					snprintf(&strbuf[offset], 5, MULDF_HEX_TAIL_FORMAT, buf[i]);
+					row_end++;
+					break;
+				default:
+					snprintf(&strbuf[offset], 4, MULDF_HEX_FORMAT, buf[i]);
+				};
+			}
+
+			display = strbuf;
+		}
+	} else {
+		display = " [REMOVED]";
+	}
+
+	total_len = strlen(display)  + 1;
+	muldf_helper_get_timestamp();
+	MULDF_PRINT_HEX(timestamp, module, cat, sub_cat, tag, display, total_len);
+
+	kfree(strbuf);
+}
+
+#endif
diff --git a/net/muldf_helper/trace.h b/net/muldf_helper/trace.h
new file mode 100644
index 0000000..e0cec07
--- /dev/null
+++ b/net/muldf_helper/trace.h
@@ -0,0 +1,123 @@
+/* SPDX-License-Identifier: ISC */
+/* Copyright (C) 2024 MediaTek Inc. */
+
+#if !defined(__MULDF_TRACE_H__) || defined(TRACE_HEADER_MULTI_READ)
+#define __MULDF_TRACE_H__
+
+#include <linux/tracepoint.h>
+
+#undef TRACE_SYSTEM
+#define TRACE_SYSTEM muldf
+
+#define MULDF_MAX_PRINT_LEN 256
+#define MULDF_MAX_HEX_PRINT_LEN 2048
+
+#define MULDF_PRINT trace_muldfps
+TRACE_EVENT(muldfps,
+	    TP_PROTO(const char *timestamp,
+		     const char *module,
+		     const char *cat,
+		     const char *sub_cat,
+		     const char *tag,
+		     const char *content, u16 len),
+
+	TP_ARGS(timestamp, module, cat, sub_cat, tag, content, len),
+
+	TP_STRUCT__entry(__array(char, timestamp, 64)
+			 __array(char, module, 32)
+			 __array(char, cat, 32)
+			 __array(char, sub_cat, 32)
+			 __array(char, tag, 32)
+			 __dynamic_array(char, content, len)
+	),
+
+	TP_fast_assign(strlcpy(__entry->timestamp, timestamp, 64);
+		       strlcpy(__entry->module, module, 32);
+		       strlcpy(__entry->cat, cat, 32);
+		       strlcpy(__entry->sub_cat, sub_cat, 32);
+		       strlcpy(__entry->tag, tag, 32);
+		       memcpy(__get_dynamic_array(content), content, len);
+	),
+
+	TP_printk("%s: %s: %s: %s: %s: %s", __entry->timestamp,
+		  __entry->module, __entry->cat, __entry->sub_cat,
+		  __entry->tag, __get_dynamic_array(content)
+	)
+);
+
+#define MULDF_PRINT_PID trace_muldfpp
+TRACE_EVENT(muldfpp,
+	    TP_PROTO(const char *timestamp,
+		     const char *module,
+		     const char *cat,
+		     const char *sub_cat,
+		     const char *tag,
+		     const char *content, u16 len, u64 pid),
+
+	TP_ARGS(timestamp, module, cat, sub_cat, tag, content, len, pid),
+
+	TP_STRUCT__entry(__array(char, timestamp, 64)
+			 __array(char, module, 32)
+			 __array(char, cat, 32)
+			 __array(char, sub_cat, 32)
+			 __array(char, tag, 32)
+			 __dynamic_array(char, content, len)
+			 __field(u64, pid)
+	),
+
+	TP_fast_assign(strlcpy(__entry->timestamp, timestamp, 64);
+		       strlcpy(__entry->module, module, 32);
+		       strlcpy(__entry->cat, cat, 32);
+		       strlcpy(__entry->sub_cat, sub_cat, 32);
+		       strlcpy(__entry->tag, tag, 32);
+		       memcpy(__get_dynamic_array(content), content, len);
+		       __entry->pid = pid;
+	),
+
+	TP_printk("%s: %s: %s: %s: %s: (pid=%ld) %s", __entry->timestamp,
+		  __entry->module, __entry->cat, __entry->sub_cat,
+		  __entry->tag, __entry->pid, __get_dynamic_array(content)
+	)
+);
+
+#define MULDF_PRINT_HEX trace_muldfps
+TRACE_EVENT(muldfph,
+	    TP_PROTO(const char *timestamp,
+		     const char *module,
+		     const char *cat,
+		     const char *sub_cat,
+		     const char *tag,
+		     const char *content, u16 len),
+
+	TP_ARGS(timestamp, module, cat, sub_cat, tag, content, len),
+
+	TP_STRUCT__entry(__array(char, timestamp, 64)
+			 __array(char, module, 32)
+			 __array(char, cat, 32)
+			 __array(char, sub_cat, 32)
+			 __array(char, tag, 32)
+			 __dynamic_array(char, content, len)
+	),
+
+	TP_fast_assign(strlcpy(__entry->timestamp, timestamp, 64);
+		       strlcpy(__entry->module, module, 32);
+		       strlcpy(__entry->cat, cat, 32);
+		       strlcpy(__entry->sub_cat, sub_cat, 32);
+		       strlcpy(__entry->tag, tag, 32);
+		       memcpy(__get_dynamic_array(content), content, len);
+	),
+
+	TP_printk("%s: %s: %s: %s: %s: %s", __entry->timestamp,
+		  __entry->module, __entry->cat, __entry->sub_cat,
+		  __entry->tag, __get_dynamic_array(content)
+	)
+);
+
+#endif
+
+#undef TRACE_INCLUDE_PATH
+#define TRACE_INCLUDE_PATH ../../net/muldf_helper
+#undef TRACE_INCLUDE_FILE
+#define TRACE_INCLUDE_FILE trace
+
+#include <trace/define_trace.h>
diff --git a/net/muldf_helper/vnet.c b/net/muldf_helper/vnet.c
new file mode 100644
index 0000000..6b6c374
--- /dev/null
+++ b/net/muldf_helper/vnet.c
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: ISC
+/* Copyright (C) 2024 MediaTek Inc. */
+
+#include "linux/netdevice.h"
+#include "linux/if_ether.h"
+#include "linux/string.h"
+#include <linux/module.h>
+#include <linux/netdevice.h>
+#include <linux/etherdevice.h>
+#include "linux/printk.h"
+#include "muldf_helper.h"
+
+static int muldf_helper_vnet_open(struct net_device *dev)
+{
+	netif_start_queue(dev);
+
+	return 0;
+}
+
+static int muldf_helper_vnet_stop(struct net_device *dev)
+{
+	netif_stop_queue(dev);
+
+	return 0;
+}
+
+static netdev_tx_t muldf_helper_vnet_start_xmit(struct sk_buff *skb, struct net_device *dev)
+{
+	dev_kfree_skb(skb);
+
+	return NETDEV_TX_OK;
+}
+
+static const struct net_device_ops vnet_netdev_ops = {
+	.ndo_open = muldf_helper_vnet_open,
+	.ndo_stop = muldf_helper_vnet_stop,
+	.ndo_start_xmit = muldf_helper_vnet_start_xmit,
+};
+
+static void muldf_helper_vnet_setup(struct net_device *dev)
+{
+	u8 mac[ETH_ALEN] = {0x00, 0x0a, 0x0b, 0x11, 0x22, 0x33};
+
+	dev->netdev_ops = &vnet_netdev_ops;
+	dev->flags |= IFF_NOARP;
+	dev->features |= NETIF_F_HW_CSUM;
+	ether_setup(dev);
+	memcpy(dev->dev_addr, mac, ETH_ALEN);
+	dev->priv_flags &= ~IFF_TX_SKB_SHARING;
+	dev->features |= NETIF_F_NETNS_LOCAL;
+}
+
+int muldf_helper_vnet_init(void)
+{
+	// create the net_device named vnet
+	p_muldf->vnet = alloc_netdev(0, "vnet0", NET_NAME_USER, muldf_helper_vnet_setup);
+	if (!p_muldf->vnet)
+		return -ENOMEM;
+
+	if (register_netdev(p_muldf->vnet)) {
+		free_netdev(p_muldf->vnet);
+		return -EINVAL;
+	}
+
+	// default active the vnet device
+	netif_carrier_on(p_muldf->vnet);
+	muldf_helper_vnet_open(p_muldf->vnet);
+
+	return 0;
+}
+
+int muldf_helper_vnet_exit(void)
+{
+	muldf_helper_vnet_stop(p_muldf->vnet);
+	netif_carrier_off(p_muldf->vnet);
+
+	unregister_netdev(p_muldf->vnet);
+	free_netdev(p_muldf->vnet);
+
+	return 0;
+}
