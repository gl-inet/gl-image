From 83318832668ecc90916c145d9c0db2312d831f5e Mon Sep 17 00:00:00 2001
From: "sujuan.chen" <sujuan.chen@mediatek.com>
Date: Wed, 14 Aug 2024 16:23:13 +0800
Subject: [PATCH] muldf: add mtk unify log dump framework muldf-helper

add debug helper to receive log/pkt/cmd/event from driver and send them
to pc-tool/muldfd

Signed-off-by: Bo Jiao <Bo.Jiao@mediatek.com>
Signed-off-by: sujuan.chen <sujuan.chen@mediatek.com>
---
 include/linux/soc/mediatek/muldf.h |  96 +++
 net/Kconfig                        |   2 +
 net/Makefile                       |   1 +
 net/muldf_helper/Kconfig           |   7 +
 net/muldf_helper/Makefile          |   8 +
 net/muldf_helper/debugfs.c         | 780 +++++++++++++++++++++++
 net/muldf_helper/muldf_helper.c    | 977 +++++++++++++++++++++++++++++
 net/muldf_helper/muldf_helper.h    | 214 +++++++
 net/muldf_helper/trace.c           | 124 ++++
 net/muldf_helper/trace.h           | 123 ++++
 net/muldf_helper/vnet.c            |  81 +++
 11 files changed, 2413 insertions(+)
 create mode 100644 include/linux/soc/mediatek/muldf.h
 create mode 100644 net/muldf_helper/Kconfig
 create mode 100644 net/muldf_helper/Makefile
 create mode 100644 net/muldf_helper/debugfs.c
 create mode 100644 net/muldf_helper/muldf_helper.c
 create mode 100644 net/muldf_helper/muldf_helper.h
 create mode 100644 net/muldf_helper/trace.c
 create mode 100644 net/muldf_helper/trace.h
 create mode 100644 net/muldf_helper/vnet.c

diff --git a/include/linux/soc/mediatek/muldf.h b/include/linux/soc/mediatek/muldf.h
new file mode 100644
index 0000000..d8322da
--- /dev/null
+++ b/include/linux/soc/mediatek/muldf.h
@@ -0,0 +1,96 @@
+/* SPDX-License-Identifier: ISC */
+/*
+ * Copyright (C) 2024 MediaTek Inc.
+ */
+#ifndef __MULDF_H
+#define __MULDF_H
+
+#include <linux/kernel.h>
+#include <linux/skbuff.h>
+
+enum muldf_log_level {
+	MTK_MSG_EXCESSIVE,
+	MTK_MSG_MSGDUMP,
+	MTK_MSG_DEBUG,
+	MTK_MSG_INFO,
+	MTK_MSG_WARNING,
+	MTK_MSG_ERROR
+};
+
+enum muldf_dump_type {
+	MTK_DUMP_NONE,
+	MTK_DUMP_PKT,
+	MTK_DUMP_CMD,
+	_MTK_DUMP_MAX
+};
+
+#ifdef CONFIG_MULDF_HELPER
+u64 muldf_alloc_pid(void);
+void muldf_xmit_event(u16 id);
+void muldf_xmit_ics(const u8 *data, u16 len);
+void muldf_xmit_pkt(u64 pid, const u8 *data, u16 len);
+void muldf_xmit_fwlog(const u8 *data, u16 len);
+
+int muldf_add_module(char *module, int def_level);
+int muldf_add_cat(char *module, char *cat);
+int muldf_add_sub_cat(char *module, char *cat, char *sub_cat, u8 pkt_dump);
+
+int muldf_del_module(char *module);
+
+void muldf_print(int level, char *module,
+		 char *cat, char *sub_cat, char *tag,
+		 const char *func, const u32 line,
+		 const char *fmt, ...);
+void muldf_print_hex(int level, char *module,
+		     char *cat, char *sub_cat, char *tag,
+		     u8 *buf, u16 len, const char *title);
+void muldf_print_pkt(int level, char *module,
+		     char *cat, char *sub_cat, char *tag,
+		     u8 *buf, u16 len, const char *fmt, ...);
+#else
+static inline u64 muldf_alloc_pid(void) { return 0; }
+static inline void muldf_xmit_event(u16 id)
+{
+	do {} while (0);
+}
+static inline void muldf_xmit_ics(const u8 *data, u16 len)
+{
+	do {} while (0);
+}
+static inline void muldf_xmit_pkt(u64 pid, const u8 *data, u16 len)
+{
+	do {} while (0);
+}
+static inline void muldf_xmit_fwlog(const u8 *data, u16 len)
+{
+	do {} while (0);
+}
+
+static inline int muldf_add_module(char *module, int def_level) { return -1; }
+static inline int muldf_add_cat(char *module, char *cat) { return -1; }
+static inline int muldf_add_sub_cat(char *module, char *cat, char *sub_cat, u8 pkt_dump)
+{
+	return -1;
+}
+static inline void muldf_print(int level, char *module,
+			       char *cat, char *sub_cat, char *tag,
+			       const char *func, const u32 line,
+			       const char *fmt, ...)
+{
+	do {} while (0);
+}
+static inline void muldf_print_hex(int level, char *module,
+				   char *cat, char *sub_cat, char *tag,
+				   u8 *buf, u16 len, const char *title)
+{
+	do {} while (0);
+}
+static inline void muldf_print_pkt(int level, char *module,
+				   char *cat, char *sub_cat, char *tag,
+				   u8 *buf, u16 len, const char *fmt, ...)
+{
+	do {} while (0);
+}
+#endif
+
+#endif /* __MULDF_H */
