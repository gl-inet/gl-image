+struct sk_buff *muldf_helper_alloc(int len)
+{
+	struct sk_buff *skb;
+
+	skb = alloc_skb(len, GFP_KERNEL);
+	if (!skb)
+		return NULL;
+
+	return skb;
+}
+
+static void __muldf_helper_xmit(u16 type, struct sk_buff *data, int data_len)
+{
+	u32 src_ip = 0, dest_ip = ~0;
+	struct pseudo_header *pseudo_h;
+	struct muldf_hdr *dbg_h;
+	struct udphdr *udp_h;
+	struct iphdr *iph;
+	struct ethhdr *eth_h;
+	u8 *hdr;
+
+	// local net_device & remoute server valid check
+	if (p_muldf->server_ip == 0 ||
+	    !p_muldf->vnet)
+		return;
+
+	if (is_zero_ether_addr(p_muldf->local_mac) &&
+	    muldf_helper_get_local_mac())
+		return;
+
+	data->dev = p_muldf->vnet;
+
+	/* unicast fwlog pkt - src ip would be x.x.x.254 */
+	if (p_muldf->server_ip != 0xFFFFFFFF) {
+		dest_ip = p_muldf->server_ip;
+		src_ip = (dest_ip & 0x00FFFFFF) | 0xFE000000;
+	}
+
+	/* prepare mtk_dbg header */
+	dbg_h = (struct muldf_hdr *)skb_push(data, sizeof(struct muldf_hdr));
+	dbg_h->ver = 0x0;
+	dbg_h->type = type;
+
+	/* prepare UDP header */
+	hdr = skb_push(data, sizeof(struct udphdr));
+	udp_h = (struct udphdr *)hdr;
+	udp_h->source = htons(PC_SERVER_MULDFH_LOCAL_PORT);
+	udp_h->dest = htons(p_muldf->server_port);
+	udp_h->len = htons(data_len + sizeof(struct udphdr));
+	udp_h->check = 0;
+
+	hdr = hdr - sizeof(struct pseudo_header);
+	pseudo_h = (struct pseudo_header *)hdr;
+	pseudo_h->saddr = src_ip;
+	pseudo_h->daddr = dest_ip;
+	pseudo_h->len = htons(data_len + sizeof(struct udphdr));
+	pseudo_h->protocol = htons(17);
+	udp_h->check = checksum16(hdr, data_len +
+				  sizeof(struct udphdr) +
+				  sizeof(struct pseudo_header));
+
+	/* prepare IP header */
+	iph = (struct iphdr *)skb_push(data, sizeof(struct iphdr));
+	iph->version = 4;
+	iph->ihl = 5;
+	iph->tos = 0;
+	iph->tot_len = htons(data_len + sizeof(struct iphdr) +
+			     sizeof(struct udphdr));
+	iph->id = 0;
+	iph->frag_off = htons(0x4000);		/* fragmentation flags and offset */
+	iph->ttl = 7;				/* time to live */
+	iph->protocol = 17;			/* protocol UDP */
+	iph->saddr = src_ip;			/* source IP */
+	iph->daddr = dest_ip;			/* destination IP */
+	iph->check = 0;
+	iph->check = checksum16((u8 *)iph, sizeof(struct iphdr)); /* IP checksum */
+
+	/* prepare 802.3 header */
+	eth_h = (struct ethhdr *)skb_push(data, LEN_802_3_H);
+	memcpy(eth_h, p_muldf->server_mac, ETH_ALEN);
+	memcpy(eth_h->h_source, p_muldf->local_mac, ETH_ALEN);
+	eth_h->h_proto = htons(0x0800);
+
+	/* report to upper layer */
+	data->protocol = eth_type_trans(data, data->dev);
+	netif_rx_ni(data);
+}
+
+static void __muldf_helper_xmit_with_hdr(u16 type,
+					 u8 *hdr, u16 hdr_len,
+					 const u8 *data, u16 data_len)
+{
+	struct sk_buff *skb = NULL;
+	/* 802.3 + IP + UDP + dbg */
+	int header_len = LEN_802_3_H + LEN_IPV4_H + LEN_UDP_H
+			 + sizeof(struct muldf_hdr);
+	int len = hdr_len + data_len;
+	bool padding = false;
+	u8 *temp;
+
+	if ((len % 2) != 0) {
+		data_len += 1;
+		len += 1;
+		padding = true;
+	}
+
+	skb = muldf_helper_alloc(header_len + len);
+	if (!skb)
+		return;
+
+	memset(skb->head, 0, header_len + len);
+	skb_reserve(skb, header_len);
+	temp  = skb_put_data(skb, hdr, hdr_len);
+	if (data_len)
+		skb_put_data(skb, data, data_len);
+
+	if (padding)
+		*(temp + len) = 0;
+
+	__muldf_helper_xmit(type, skb, sizeof(struct muldf_hdr) + len);
+}
