. ${SQM_LIB_DIR}/defaults.sh
QDISC=cake


# to keep this as simple as possible we ignore the *_CAKE_OPTS from defaults.sh
INGRESS_CAKE_OPTS="besteffort"
EGRESS_CAKE_OPTS="besteffort"


egress() {
    sqm_debug "egress"
    local lan_ipaddr=`uci -q get network.lan.ipaddr`
    # In the default configuration of sqm, the name of the configuration section is 'eth1'
    # When the configuration is deleted in luci and then added again, this configuration
    # section name will be lost, resulting in the rules not being applied after the device
    # restarts. Now, the configuration section name is reconfigured to the default value at
    # the time of script startup. Note that this section name is not the actual effective interface.
    uci rename sqm.@queue[0]='eth1'
    uci commit sqm
    SILENT=1 $TC qdisc del dev $IFACE root
    if [ "$IFACE" = "br-lan" ]; then
        $TC qdisc add dev $IFACE root handle 1: htb
        $TC class add dev $IFACE parent 1: classid 1:10 htb rate 2500000kbit
        $TC class add dev $IFACE parent 1: classid 1:20 htb rate 2500000kbit
        $TC qdisc add dev $IFACE parent 1:20 cake \
            bandwidth ${UPLINK}kbit $( get_cake_lla_string ) ${EGRESS_CAKE_OPTS} ${EQDISC_OPTS}

        $TC filter add dev $IFACE parent 1: protocol ip prio 1 u32 \
            match ip dst $lan_ipaddr flowid 1:10

        $TC filter add dev $IFACE parent 1: protocol ip prio 2 u32 \
            match ip src $lan_ipaddr flowid 1:10

        $TC filter add dev $IFACE parent 1: protocol ip prio 11 u32 \
            match ip src 0.0.0.0/0 flowid 1:20
    else
        $TC qdisc add dev $IFACE root $( get_stab_string ) cake \
            bandwidth ${UPLINK}kbit $( get_cake_lla_string ) ${EGRESS_CAKE_OPTS} ${EQDISC_OPTS}
    fi
}


ingress() {
    sqm_debug "ingress"
    local lan_ipaddr=`uci -q get network.lan.ipaddr`
    SILENT=1 $TC qdisc del dev $IFACE handle ffff: ingress
    $TC qdisc add dev $IFACE handle ffff: ingress
    SILENT=1 $TC qdisc del dev $DEV root

    [ "$ZERO_DSCP_INGRESS" -eq "1" ] && INGRESS_CAKE_OPTS="$INGRESS_CAKE_OPTS wash"
    if [ "$IFACE" = "br-lan" ]; then
        $TC qdisc add dev $DEV root handle 1: htb
        $TC class add dev $DEV parent 1: classid 1:10 htb rate 2500000kbit
        $TC class add dev $DEV parent 1: classid 1:20 htb rate 2500000kbit

        $TC qdisc add dev $DEV parent 1:20 cake \
            bandwidth ${DOWNLINK}kbit $( get_cake_lla_string ) ${INGRESS_CAKE_OPTS} ${IQDISC_OPTS}

        $TC filter add dev $DEV parent 1: protocol ip prio 1 u32 \
            match ip dst $lan_ipaddr flowid 1:10

        $TC filter add dev $DEV parent 1: protocol ip prio 2 u32 \
            match ip src $lan_ipaddr flowid 1:10

        $TC filter add dev $DEV parent 1: protocol ip prio 3 u32 \
            match ip src 0.0.0.0/0 flowid 1:20
    else
        $TC qdisc add dev $DEV root $( get_stab_string ) cake \
            bandwidth ${DOWNLINK}kbit $( get_cake_lla_string ) ${INGRESS_CAKE_OPTS} ${IQDISC_OPTS}
    fi

    $IP link set dev $DEV up

    # redirect all IP packets arriving in $IFACE to ifb0

    $TC filter add dev $IFACE parent ffff: protocol all prio 10 u32 \
        match u32 0 0 flowid 1:1 action mirred egress redirect dev $DEV
}

sqm_prepare_script() {
    do_modules
    verify_qdisc $QDISC "cake" || return 1
}
