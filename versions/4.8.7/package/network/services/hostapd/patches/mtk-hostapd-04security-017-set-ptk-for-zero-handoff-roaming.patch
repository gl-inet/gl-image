 }
 #endif /*HOSTAPD_PMKID_IN_DRIVER_SUPPORT*/
 
+#ifdef ZERO_HANDOFF_ROAMING
+int hostapd_set_ptk_to_driver(void *priv,
+					     struct wpa_ptk_entry *params)
+{
+	struct i802_bss *bss = priv;
+	struct wpa_driver_nl80211_data *drv = bss->drv;
+	struct nl_msg *msg = NULL;
+	struct nlattr *attr;
+	int ret = -1;
+	int ParamSize= sizeof(struct wpa_ptk_entry);
+
+	wpa_printf(MSG_INFO, "sta mac:" MACSTR 
+				"set ptk to driver,  ParamSize:%d",
+				MAC2STR(params->sta_mac), ParamSize);
+
+	wpa_hexdump(MSG_INFO, "WPA: PTK dump", &params->ptk[0], params->ptk_len);
+	if (!(msg = nl80211_drv_msg(drv, 0, NL80211_CMD_VENDOR)) ||
+			nla_put_u32(msg, NL80211_ATTR_VENDOR_ID, MTK_NL80211_VENDOR_ID) ||
+			nla_put_u32(msg, NL80211_ATTR_VENDOR_SUBCMD, MTK_NL80211_VENDOR_SUBCMD_SET_AP_PTK))
+			goto fail;
+
+	attr = nla_nest_start(msg, NL80211_ATTR_VENDOR_DATA);
+	if (!attr)
+		goto fail;
+
+	if (nla_put(msg, MTK_NL80211_VENDOR_ATTR_SET_AP_PTK, sizeof(struct wpa_ptk_entry),
+				(void *)params))
+		goto fail;
+
+	nla_nest_end(msg, attr);
+
+	ret = send_and_recv_msgs(drv, msg, NULL, NULL, NULL, NULL);
+	if (ret)
+		wpa_printf(MSG_DEBUG, "nl80211: ap ptk vendor command failed err=%d",
+				  ret);
+	return ret;
+
+	wpa_printf(MSG_INFO, "set ptk to driver 126");
+fail:
+	nlmsg_free(msg);
+	return ret;
+}
+#endif /*ZERO_HANDOFF_ROAMING*/
+
