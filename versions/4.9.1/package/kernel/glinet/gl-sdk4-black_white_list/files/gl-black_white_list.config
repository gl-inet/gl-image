config global 'global'
    option enable '1'
    option mode 'black'

config list 'black'

config list 'white'

config secure_option 'lan'
    option ap_isolate '0'

config secure_option 'guest'
    option ap_isolate '1'
    option wan_isolate '0'
    option transfer_enable '0'

config secure_option 'iot'
    option ap_isolate '1'
    option wan_isolate '0'
    option transfer_enable '0'