 static void sfp_sm_mod_remove(struct sfp *sfp)
 {
+	if (sfp_is_be14000_slot(sfp->dev)) {
+		void (*remove_cb)(void);
+
+		mutex_lock(&yt9224_sfp_lock);
+		be14000_sfp = NULL;
+		yt9224_pending_valid = false;
+		be14000_los_replay_pending = false;
+		remove_cb = yt9224_sfp_remove_cb;
+		mutex_unlock(&yt9224_sfp_lock);
+		if (remove_cb)
+			remove_cb();
+	}
 	if (sfp->sm_mod_state > SFP_MOD_WAITDEV)
 		sfp_module_remove(sfp->sfp_bus);
 
@@ -2578,6 +2734,10 @@
 	sfp_sm_module(sfp, event);
 	sfp_sm_main(sfp, event);
 
+	sfp_be14000_los_low_notify(sfp, event);
+	sfp_be14000_los_high_notify(sfp, event);
+	sfp_be14000_los_replay_if_needed(sfp);
+
 	dev_info(sfp->dev, "SM: exit %s:%s:%s\n",
 		mod_state_to_str(sfp->sm_mod_state),
 		dev_state_to_str(sfp->sm_dev_state),
@@ -2909,6 +3069,19 @@
 	if (!sfp->sfp_bus)
 		return -ENOMEM;
 
+	/*
+	 * BE14000: switch readiness and module probing can race. When a module
+	 * is already present, trigger one timeout event to keep identification
+	 * and EEPROM replay moving after the socket is registered.
+	 */
+	if (of_machine_is_compatible("glinet,gl-be14000") &&
+	    of_device_is_compatible(sfp->dev->of_node, "sff,sfp") &&
+	    (sfp->state & SFP_F_PRESENT)) {
+		rtnl_lock();
+		sfp_module_tx_enable(sfp);
+		sfp_sm_event(sfp, SFP_E_TIMEOUT);
+		rtnl_unlock();
+	}
 	sfp_debugfs_init(sfp);
 
 	return 0;
