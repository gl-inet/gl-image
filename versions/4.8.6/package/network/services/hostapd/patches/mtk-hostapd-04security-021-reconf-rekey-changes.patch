+/*
+* Handle Group Key Rekeying in Multi-Link Operation (MLO) when the main (associated) link is deleted.
+*
+* In MLO, if the main link is deleted and a group rekey is triggered from another link,
+* the state machine for that non-main link may not be present. In such cases, the rekey
+* packet should be handled by the link that still has a valid state machine.
+*
+* The following logic searches for an MLO station (sm_sta) with a state machine and
+* reconfiguration in progress. If the main link is deleted (primary_link_del set),
+* and the rekey packet's source address matches any of the station's link addresses,
+* the rekey operation is redirected to the link with the available state machine.
+*/
+#if defined(CONFIG_MTK_IEEE80211BE) && defined(CONFIG_RECONF)
+	if (hapd->conf->reconf_rekey == 1) {
+		struct sta_info *sm_sta; /* MLO station with a state machine */
+		struct wpa_ml_group *ml_group;
+		int i, j;
+		int found;
+		ml_group = hapd->ml_group;
+		if (ml_group) {
+			for (sm_sta = hapd->sta_list; sm_sta != NULL; sm_sta = sm_sta->next) {
+				if (sm_sta->wpa_sm && sm_sta->wpa_sm->reconfig_del) {
+					/* Only consider stations eligible for group rekey */
+					if (sm_sta->wpa_sm->valid_rekey != 1 || !sm_sta->wpa_sm->sta_ml_ie)
+						continue;
+					/* Check if the primary link is deleted or added again */
+					if (sm_sta->wpa_sm->primary_link_del == 0 || sm_sta->wpa_sm->primary_link_del == 1) {
+						/* Check if the source address matches any of the link addresses */
+						found = 0;
+						for (j = 0; j < sm_sta->wpa_sm->sta_ml_ie->prof_num; j++) {
+							if (os_memcmp(sa, sm_sta->wpa_sm->sta_ml_ie->profiles[j].addr, ETH_ALEN) == 0) {
+								found = 1;
+								break;
+							}
+						}
+						/* If a match is found, update sta to use the station with the state machine */
+						if (found) {
+							sta = sm_sta;
+							wpa_printf(MSG_DEBUG, "Updated sta addr: assoc link is deleted "MACSTR, MAC2STR(sta->addr));
+							break;
+						}
+					}
+				}
+			}
+		}
+	}
+#endif /* CONFIG_MTK_IEEE80211BE */
 	if (!sta || (!(sta->flags & (WLAN_STA_ASSOC | WLAN_STA_PREAUTH)) &&
