+/*CCN67_ANQP*/
+int hostapd_ctrl_iface_rks_resp(struct hostapd_data *hapd,
+				  const char *cmd)
+{
+	u8 addr[ETH_ALEN];
+	char *delim;
+	size_t len;
+	struct wpabuf *payload, *buf;
+	int ret = 0;
+	const char *pos;
+	int dialog_token = 0;
+	struct gas_dialog_info *dialog;
+	struct sta_info *sta;
+	u8 *cert_resp_len;
+	int cert_resp, join_resp = 0;
+
+	if (hwaddr_aton(cmd, addr)) {
+		wpa_printf(MSG_DEBUG, "Invalid STA MAC address");
+		return -1;
+	}
+
+	pos = os_strstr(cmd, " token=");
+	if (pos) {
+		pos += 7;
+		dialog_token = atoi(pos);
+	}
+
+	if ((delim = os_strstr(cmd, " ZTM_NTF_CERT_RESP=")) > 0) {
+		cert_resp = 1;
+		join_resp = 0;
+		wpa_printf(MSG_ERROR, "cert_resp received");
+	} else if((delim = os_strstr(cmd, " ZTM_NTF_JOIN_RESP=")) > 0) {
+		join_resp = 1;
+		cert_resp = 0;
+		wpa_printf(MSG_ERROR, "join_resp received");
+	}
+	if(delim) {
+		delim += 19;
+	} else
+		return -1;
+
+	len = os_strlen(delim);
+	if (len & 1)
+		return -1;
+	len /= 2;
+	payload = wpabuf_alloc(len);
+	if (!payload)
+		return -1;
+	if (hexstr2bin(delim, wpabuf_put(payload, len), len) < 0) {
+		wpabuf_free(payload);
+		return -1;
+	}
+	wpa_printf(MSG_ERROR, "STA MAC address " MACSTR ", Token = %d", MAC2STR(addr),dialog_token);
+	wpa_hexdump_buf(MSG_ERROR, "payload is", payload);
+	dialog = gas_serv_dialog_find(hapd, addr, dialog_token);
+	if(!dialog)
+		wpa_printf(MSG_ERROR, "Dialog not found");
+	else {
+		if(dialog->sd_resp)
+			wpa_hexdump_buf(MSG_ERROR, "Stored RKS buf is", dialog->sd_resp);
+		else
+			wpa_printf(MSG_ERROR, "Dialog found but it is zero");
+	}
+	buf = wpabuf_alloc(15 + len);
+	if (buf == NULL)
+		return -1;
+	if (cert_resp) {
+		cert_resp_len = gas_anqp_add_element(buf, ANQP_VENDOR_SPECIFIC);
+		wpabuf_put_be24(buf, OUI_RUCKUS);
+		wpabuf_put_u8(buf, RKS_ANQP_OUI_TYPE);
+		wpabuf_put_u8(buf, RKS_ANQP_STYPE_CERT_RESP);
+		wpabuf_put_u8(buf, 0); /* Reserved */
+		wpabuf_put_buf(buf, payload); /*cert response payload*/
+		gas_anqp_set_element_len(buf, cert_resp_len);
+		wpa_printf(MSG_ERROR, "Send RKS ANQP ZTM Cert Resp");
+		gas_serv_req_rks_anqp_processing(hapd, addr, dialog_token, 0, buf);
+	} else if (join_resp) {
+		wpa_printf(MSG_ERROR, "Join response received");
+		if (dialog) {
+			wpa_printf(MSG_ERROR, "Copy ZTM Join Resp Payload");
+			dialog->sd_resp = payload ;
+		}
+	} else {
+		wpa_printf(MSG_ERROR, "No response received");
+		return -1;
+	}
+	return ret;
+}
