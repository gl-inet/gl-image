+/*CCN67_ANQP*/
+void rx_anqp_rks_cert_req(struct hostapd_data *hapd,
+                                    u8 payload,	const u8 *sa, u8 dialog_token,
+									struct wpabuf *buf)
+{
+	u8 prep_cert;
+	char addr[100];
+
+	if ((payload == RKS_CERT_REQ_AP_TYPE_SOLO) ||
+			(payload == RKS_CERT_REQ_AP_TYPE_ZD) ||
+			(payload == RKS_CERT_REQ_AP_TYPE_UNLEASHED) ||
+			(payload == RKS_CERT_REQ_AP_TYPE_SZ))  {
+				prep_cert = 1;
+				hapd->conf->gas_comeback_delay = 0;
+	} else {
+			wpa_printf(MSG_DEBUG, "RKS ANQP ZTM: Unsupported %u subtype in Cert Req",
+					payload);
+			   prep_cert = 0;
+			   return;
+	}
+	if(prep_cert) {
+		struct gas_dialog_info *di;
+		/*Send request data to ZTMD*/
+		os_snprintf(addr, sizeof(addr), MACSTR, MAC2STR(sa));
+		wpa_msg(hapd->msg_ctx, MSG_ERROR, RKS_ANQP_CERT_REQ  " %s %u %u",  addr, dialog_token, payload);
+
+		di = gas_dialog_create(hapd, sa, dialog_token);
+		if (!di) {
+			wpa_printf(MSG_INFO, "RKS ANQP ZTM CERT REQ: Could not create dialog "
+				   "for " MACSTR " (dialog token %u)",
+				   MAC2STR(sa), dialog_token);
+		} else {
+			wpa_printf(MSG_DEBUG, "RKS ANQP ZTM CERT REQ: Waiting for ZTMD response");
+		}
+	}
+}
+
+void rx_anqp_rks_join_req(struct hostapd_data *hapd,
+                                    u8 payload, const u8 *sa, u8 dialog_token,
+									struct wpabuf *buf)
+{
+	u8 *join_resp_len;
+	char addr[100];
+	struct gas_dialog_info *di;
+
+	/*set GAS come back delay
+	Send GAS Initial Response with
+	gas_comeback_delay 300*/
+
+	hapd->conf->gas_comeback_delay = 300;
+	/*Send request data to ZTMD*/
+	os_snprintf(addr, sizeof(addr), MACSTR, MAC2STR(sa));
+	wpa_msg(hapd->msg_ctx, MSG_ERROR, RKS_ANQP_JOIN_REQ  " %s %u %u",  addr, dialog_token, payload);
+
+	wpa_printf(MSG_ERROR, "RKS ANQP ZTM: Preparing ZTM Join response with delay");
+	join_resp_len = gas_anqp_add_element(buf, ANQP_VENDOR_SPECIFIC);
+	wpabuf_put_be24(buf, OUI_RUCKUS);
+	wpabuf_put_u8(buf, RKS_ANQP_OUI_TYPE);
+	wpabuf_put_u8(buf, RKS_ANQP_STYPE_JOIN_RESP);
+	wpabuf_put_u8(buf, 0); /* Reserved */
+	gas_anqp_set_element_len(buf, join_resp_len);
+
+	di = gas_dialog_create(hapd, sa, dialog_token);
+	if (!di) {
+		wpa_printf(MSG_INFO, "RKS ANQP ZTM JOIN REQ: Could not create dialog "
+				"for " MACSTR " (dialog token %u)",
+				MAC2STR(sa), dialog_token);
+	} else {
+		wpa_printf(MSG_DEBUG, "RKS ANQP ZTM JOIN RESP: Sent Resposne with 300 delay");
+	}
+}
+
+struct wpabuf * rx_anqp_vendor_specific_rks(struct hostapd_data *hapd,
+					const u8 *sa, const u8 *query, size_t query_len,
+					const u8 *data, size_t data_len, u8 dialog_token)
+{
+    struct wpabuf *msg;
+    const u8 *pos = query, *end = query + data_len;
+	u8 type, subtype;
+
+	msg = wpabuf_alloc(100);
+	if (msg == NULL)
+		return NULL;
+
+	if (end - pos <= 1)
+		return NULL;
+
+	pos += 3;
+	if (*pos != RKS_ANQP_OUI_TYPE)
+		return NULL;
+
+	type = *pos++;
+	subtype = *pos++;
+	wpa_printf(MSG_ERROR, "RKS ANQP ZTM Req: Received subtype %u ", subtype);
 
+	pos++; /* Reserved */
+
+	switch (subtype) {
+	case RKS_ANQP_STYPE_CERT_REQ:
+		wpa_printf(MSG_ERROR, "ANQP: RKS Cert Req");
+		rx_anqp_rks_cert_req(hapd, *pos, sa, dialog_token, msg);
+		msg = NULL;
+		break;
+	case RKS_ANQP_STYPE_JOIN_REQ:
+        wpa_printf(MSG_ERROR, "ANQP: RKS Join Req");
+		rx_anqp_rks_join_req(hapd, *pos, sa, dialog_token, msg);
+		break;
+	default:
+		wpa_printf(MSG_ERROR, "RKS ANQP: Unsupported Subtype "
+								"%u", subtype);
+		break;
+	}
+
+	return msg;
+}
+void gas_serv_req_rks_anqp_processing(struct hostapd_data *hapd,
+					  const u8 *sa, u8 dialog_token,
+					  int prot, struct wpabuf *buf)
+{
+	struct wpabuf *tx_buf;
+
+	if (wpabuf_len(buf) > hapd->conf->gas_frag_limit ||
+	    hapd->conf->gas_comeback_delay) {
+		struct gas_dialog_info *di;
+		u16 comeback_delay = 1;
+
+		if (hapd->conf->gas_comeback_delay) {
+			/* Testing - allow overriding of the delay value */
+			comeback_delay = hapd->conf->gas_comeback_delay;
+		}
+
+		wpa_printf(MSG_DEBUG, "RKS ANQP RESP: Too long response to fit in "
+			   "initial response - use GAS comeback");
+		di = gas_dialog_create(hapd, sa, dialog_token);
+		if (!di) {
+			wpa_printf(MSG_INFO, "ANQP: Could not create dialog "
+				   "for " MACSTR " (dialog token %u)",
+				   MAC2STR(sa), dialog_token);
+			wpabuf_free(buf);
+			tx_buf = gas_anqp_build_initial_resp_buf(
+				dialog_token, WLAN_STATUS_UNSPECIFIED_FAILURE,
+				0, NULL);
+		} else {
+			di->prot = prot;
+			di->sd_resp = buf;
+			di->sd_resp_pos = 0;
+			tx_buf = gas_anqp_build_initial_resp_buf(
+				dialog_token, WLAN_STATUS_SUCCESS,
+				comeback_delay, NULL);
+		}
+	} else {
+		wpa_printf(MSG_DEBUG, "RKS ANQP: Initial response (no comeback)");
+		tx_buf = gas_anqp_build_initial_resp_buf(
+			dialog_token, WLAN_STATUS_SUCCESS, 0, buf);
+		wpa_hexdump_buf(MSG_ERROR, "tx_buf is", tx_buf);
+		wpabuf_free(buf);
+	}
+	if (!tx_buf)
+		return;
+	if (prot)
+		convert_to_protected_dual(tx_buf);
+
+	hostapd_drv_send_action(hapd, hapd->iface->freq, 0, sa,
+				wpabuf_head(tx_buf),
+				wpabuf_len(tx_buf));
+	wpabuf_free(tx_buf);
+}
