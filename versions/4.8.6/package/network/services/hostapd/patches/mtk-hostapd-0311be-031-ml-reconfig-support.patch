+static void mtk_nl80211_ml_reconf_event(struct wpa_driver_nl80211_data *drv, struct i802_bss *bss,
+					u8 *data, size_t len)
+{
+
+	struct nlattr *tb[MTK_NL80211_VENDOR_ATTR_ML_RECONF_MAX + 1];
+	union wpa_event_data event;
+	u8 num = 0;
+
+	if (nla_parse(tb, MTK_NL80211_VENDOR_ATTR_ML_RECONF_MAX, (struct nlattr *)data, len, NULL)) {
+		wpa_printf(MSG_DEBUG, "Invalid ML info attribute\n");
+		return;
+	}
+
+	if (!tb[MTK_NL80211_VENDOR_ATTR_ML_RECONF_STA] ||
+		!tb[MTK_NL80211_VENDOR_ATTR_ML_RECONF_LINK_NUM] ||
+		!tb[MTK_NL80211_VENDOR_ATTR_ML_RECONF_LINK_INFO])
+		return;
+
+	if (tb[MTK_NL80211_VENDOR_ATTR_ML_RECONF_STA])
+		os_memcpy(event.reconf_event.addr, nla_data(tb[MTK_NL80211_VENDOR_ATTR_ML_RECONF_STA]), ETH_ALEN);
+
+	if (tb[MTK_NL80211_VENDOR_ATTR_ML_RECONF_LINK_NUM])
+		num = nla_get_u8(tb[MTK_NL80211_VENDOR_ATTR_ML_RECONF_LINK_NUM]);
+
+	event.reconf_event.link_num = num;
+	if (num > (ML_MAX_LINK_NUM * 2)) {
+		wpa_printf(MSG_ERROR, "ML: Invalid link num: %u", num);
+		return;
+	}
+
+	if (tb[MTK_NL80211_VENDOR_ATTR_ML_RECONF_LINK_INFO])
+		os_memcpy(event.reconf_event.link, nla_data(tb[MTK_NL80211_VENDOR_ATTR_ML_RECONF_LINK_INFO]),
+			 num * sizeof(struct ml_reconf_info));
+
+	wpa_supplicant_event(bss->ctx, EVENT_NOTIFY_ML_RECONF, &event);
+}
