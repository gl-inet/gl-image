+static int nl80211_set_ml_reconf_kde(struct wpa_driver_nl80211_data *drv,
+		u8 *gtk, size_t gtk_len, u8 *igtk, size_t igtk_len, u8 *bigtk, size_t bigtk_len)
+{
+	struct nl_msg *msg = NULL;
+	struct nlattr *attr = NULL;
+	int ret = 0;
+
+	wpa_printf(MSG_DEBUG, "nl80211_set_ml_reconf_kde");
+
+	if (!(msg = nl80211_drv_msg(drv, 0, NL80211_CMD_VENDOR)) ||
+		nla_put_u32(msg, NL80211_ATTR_VENDOR_ID, MTK_NL80211_VENDOR_ID) ||
+		nla_put_u32(msg, NL80211_ATTR_VENDOR_SUBCMD, MTK_NL80211_VENDOR_SUBCMD_SET_MLO_KDE)) {
+		nlmsg_free(msg);
+		return -1;
+	}
+
+	attr = nla_nest_start(msg, NL80211_ATTR_VENDOR_DATA);
+	if(!attr) {
+		wpa_printf(MSG_ERROR, "nl80211: nla_nest_start FAIL");
+		goto fail;
+	}
+
+	if (nla_put(msg, MTK_NL80211_VENDOR_ATTR_MLO_GTK_KDE, gtk_len, gtk))
+		goto fail;
+
+	if (nla_put(msg, MTK_NL80211_VENDOR_ATTR_MLO_IGTK_KDE, igtk_len, igtk))
+		goto fail;
+
+	if (bigtk_len != 0 && nla_put(msg, MTK_NL80211_VENDOR_ATTR_MLO_BIGTK_KDE, bigtk_len, bigtk))
+		goto fail;
+
+	nla_nest_end(msg, attr);
+
+	ret = send_and_recv_msgs(drv, msg, NULL, NULL, NULL, NULL);
+	if (ret)
+		wpa_printf(MSG_DEBUG, "nl80211: vendor command set ml reconf kde fail");
+	return ret;
+fail:
+	nlmsg_free(msg);
+	return -1;
+}
+
+static int wpa_driver_nl80211_set_ml_reconf_kde(void *priv, u8 *gtk, size_t gtk_len,
+		u8 *igtk, size_t igtk_len, u8 *bigtk, size_t bigtk_len)
+{
+	struct i802_bss *bss = priv;
+	struct wpa_driver_nl80211_data *drv = bss->drv;
+
+	wpa_printf(MSG_DEBUG, "nl80211: set gourp key data for ML Reconfiguration");
+
+	return nl80211_set_ml_reconf_kde(drv, gtk, gtk_len, igtk, igtk_len, bigtk, bigtk_len);
+}
+
