+void ml_reconf_add_sta_link(struct wpa_state_machine *sm, struct ml_reconf_info *info)
+{
+	u8 i = 0;
+	int found = 0;
+
+	for (i = 0; i < sm->sta_ml_ie->prof_num; i++) {
+		if (info->link_id == sm->sta_ml_ie->profiles[i].link_id)
+			found = 1;
+	}
+
+	if (found == 1) {
+		os_memcpy(sm->sta_ml_ie->profiles[sm->sta_ml_ie->prof_num].addr,
+			info->link_addr, ETH_ALEN);
+		return;
+	}
+
+	if (sm->sta_ml_ie->prof_num + 1 > ML_MAX_LINK_NUM)
+		return;
+	sm->sta_ml_ie->profiles[sm->sta_ml_ie->prof_num].link_id = info->link_id;
+	os_memcpy(sm->sta_ml_ie->profiles[sm->sta_ml_ie->prof_num].addr,
+			info->link_addr, ETH_ALEN);
+	sm->sta_ml_ie->prof_num++;
+}
+
+void ml_reconf_del_sta_link (struct wpa_state_machine *sm, struct ml_reconf_info *info)
+{
+	u8 i = 0, j = 0;
+	int found = 0;
+
+	for (i = 0; i < sm->sta_ml_ie->prof_num; i++) {
+		if (info->link_id == sm->sta_ml_ie->profiles[i].link_id)
+			found = 1;
+	}
+
+	if (found == 0)
+		return;
+
+	for ( j = i; j + 1 < sm->sta_ml_ie->prof_num ; j++)
+		memcpy(&sm->sta_ml_ie->profiles[j], &sm->sta_ml_ie->profiles[j + 1], sizeof(struct per_sta_profile));
+
+	sm->sta_ml_ie->prof_num--;
+}
+
+struct sta_info *ml_get_sta_by_mld_addr(struct hostapd_data *hapd, u8 *mld_addr)
+{
+	struct sta_info *sta;
+	struct wpa_state_machine *sm;
+
+	for (sta = hapd->sta_list; sta != NULL; sta = sta->next) {
+		sm = sta->wpa_sm;
+		if (sm && sm->sta_ml_ie) {
+			if (os_memcmp(sm->sta_ml_ie->ml_addr, mld_addr, ETH_ALEN) == 0)
+				return sta;
+		}
+	}
+	return NULL;
+}
+
+int ml_reconfig_update_sta_link(struct hostapd_data *hapd, u8 *addr, u8 link_num, struct ml_reconf_info *info)
+{
+	struct sta_info *sta;
+	struct wpa_state_machine *sm;
+	u8 found = 0;
+	u8 i;
+
+	/*find the sta by mld_addr*/
+	sta = ml_get_sta_by_mld_addr(hapd, addr);
+	if (!sta) {
+		wpa_printf(MSG_INFO,"ML Link reconfig: this sta ("MACSTR") is not associated with any interface", MAC2STR(addr));
+		return -1;
+	}
+
+	sm = sta->wpa_sm;
+		/*delete link firstly*/
+	for (i = 0 ; i < link_num; i++) {
+		if (info[i].event_id != 1)
+			continue;
+		wpa_printf(MSG_DEBUG, "Link id(%d): dellink event(%d)", info[i].link_id, info[i].event_id);
+		ml_reconf_del_sta_link(sm, &info[i]);
+	}
+
+	for (i = 0 ; i < link_num; i++) {
+		if (info[i].event_id != 0)
+			continue;
+		 wpa_printf(MSG_DEBUG, "Link id(%d): addlink event(%d)", info[i].link_id, info[i].event_id);
+		 ml_reconf_add_sta_link(sm, &info[i]);
+	}
+
+	return 0;
+}
+
+int ml_reconfig_send_kde(struct hostapd_data *hapd, struct wpa_ml_link *link)
+{
+	struct wpa_authenticator *auth = hapd->wpa_auth;
+	struct wpa_auth_config *conf = &auth->conf;
+	struct wpa_group *gsm = auth->group;
+	struct wpa_mlo_gtk_kde gtk;
+	size_t gtk_len = 0;
+	struct wpa_mlo_igtk_kde igtk;
+	size_t igtk_len = 0;
+	struct wpa_mlo_bigtk_kde bigtk;
+	size_t bigtk_len = 0;
+	int gtkidx;
+	u8 rsc[WPA_KEY_RSC_LEN];
+	size_t gtk_kde_len = 0, igtk_kde_len = 0, bigtk_kde_len = 0;
+	u8 *gtk_kde = NULL, *igtk_kde = NULL, *bigtk_kde = NULL;
+	u8 *pos = NULL;
+
+	os_memset(&gtk, 0, sizeof(gtk));
+	os_memset(&igtk, 0, sizeof(igtk));
+	os_memset(&bigtk, 0, sizeof(bigtk));
+
+	/*GTK KDE*/
+	gtk_len = gsm->GTK_len;
+	os_memcpy(gtk.gtk, gsm->GTK[gsm->GN - 1], gtk_len);
+	gtkidx = gsm->GN;
+	gtk.info = (gtkidx & 0x03) | (link->link_id & 0x0f) << 4;
+
+	gtk_kde_len = 2 + RSN_SELECTOR_LEN + WPA_MLO_GTK_KDE_PREFIX_LEN + gtk_len;
+	gtk_kde = os_malloc(gtk_kde_len);
+	if (gtk_kde == NULL)
+		goto err;
+	pos = gtk_kde;
+	pos = wpa_add_kde(pos, RSN_KEY_DATA_MLO_GTK,
+					(const u8 *)&gtk, WPA_MLO_GTK_KDE_PREFIX_LEN + gtk_len,
+					NULL, 0);
+	wpa_hexdump(MSG_DEBUG, "ML Reconfig: Send GTK KDE", gtk_kde, gtk_kde_len);
+
+	/*IGTK KDE*/
+	if (conf->ieee80211w != NO_MGMT_FRAME_PROTECTION) {
+		igtk_len = wpa_cipher_key_len(conf->group_mgmt_cipher);
+		igtk.keyid[0] = gsm->GN_igtk;
+		igtk.keyid[1] = 0;
+		if (gsm->wpa_group_state != WPA_GROUP_SETKEYSDONE ||
+			ml_get_seqnum(auth, NULL, gsm->GN_igtk, rsc) < 0)
+			os_memset(igtk.pn, 0, sizeof(igtk.pn));
+		else
+			os_memcpy(igtk.pn, rsc, sizeof(igtk.pn));
+		os_memcpy(igtk.igtk, gsm->IGTK[gsm->GN_igtk - 4], igtk_len);
+		igtk.info = (link->link_id & 0x0f) << 4;
+
+		igtk_kde_len = 2 + RSN_SELECTOR_LEN + WPA_MLO_IGTK_KDE_PREFIX_LEN + igtk_len;
+		igtk_kde = os_malloc(igtk_kde_len);
+		if (igtk_kde == NULL)
+			goto err;
+		pos = igtk_kde;
+		pos = wpa_add_kde(pos, RSN_KEY_DATA_MLO_IGTK,
+					(const u8 *)&igtk, WPA_MLO_IGTK_KDE_PREFIX_LEN + igtk_len,
+					NULL, 0);
+		wpa_hexdump(MSG_DEBUG, "ML Reconfig: Send IGTK KDE", igtk_kde, igtk_kde_len);
+	}
+
+	/*BIGKT KDE*/
+	if (conf->ieee80211w != NO_MGMT_FRAME_PROTECTION && conf->beacon_prot) {
+		bigtk_len = wpa_cipher_key_len(conf->group_mgmt_cipher);
+		bigtk.keyid[0] = gsm->GN_bigtk;
+		bigtk.keyid[1] = 0;
+		if (gsm->wpa_group_state != WPA_GROUP_SETKEYSDONE ||
+			ml_get_seqnum(auth, NULL, gsm->GN_bigtk, rsc) < 0)
+			os_memset(bigtk.pn, 0, sizeof(bigtk.pn));
+		else
+			os_memcpy(bigtk.pn, rsc, sizeof(bigtk.pn));
+		os_memcpy(bigtk.bigtk, gsm->BIGTK[gsm->GN_bigtk - 6], bigtk_len);
+		bigtk.info = (link->link_id & 0x0f) << 4;
+
+		bigtk_kde_len = 2 + RSN_SELECTOR_LEN + WPA_MLO_BIGTK_KDE_PREFIX_LEN + bigtk_len;
+		bigtk_kde = os_malloc(bigtk_kde_len);
+		if (bigtk_kde == NULL)
+			goto err;
+		pos = bigtk_kde;
+		pos = wpa_add_kde(pos, RSN_KEY_DATA_MLO_BIGTK,
+					(const u8 *)&bigtk, WPA_MLO_BIGTK_KDE_PREFIX_LEN + bigtk_len,
+					NULL, 0);
+		wpa_hexdump(MSG_DEBUG, "ML Reconfig: Send BIGTK KDE", bigtk_kde, bigtk_kde_len);
+	}
+
+	/*Send Group KDE to Driver*/
+	if (hapd->driver && hapd->driver->set_ml_reconf_kde)
+		hapd->driver->set_ml_reconf_kde(hapd->drv_priv,
+			gtk_kde, gtk_kde_len, igtk_kde, igtk_kde_len, bigtk_kde, bigtk_kde_len);
+	os_free(gtk_kde);
+	os_free(igtk_kde);
+	os_free(bigtk_kde);
+	return 0;
+err:
+	if (gtk_kde)
+		os_free(gtk_kde);
+	if (igtk_kde)
+		os_free(igtk_kde);
+	if (bigtk_kde)
+		os_free(bigtk_kde);
+	return -1;
+}
 
