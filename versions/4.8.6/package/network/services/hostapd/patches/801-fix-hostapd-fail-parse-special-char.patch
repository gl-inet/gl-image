From 6d4d0e8db3951f5c49adce3eba5975ccf28a49cc Mon Sep 17 00:00:00 2001
From: "jiajun.wang" <jiajun.wang@gl-inet.com>
Date: Wed, 21 Jan 2026 14:26:16 +0800
Subject: [PATCH] fix: fix the issue where hostapd fails to properly parse
 special characters. #SDK-20806

*none

Signed-off-by: jiajun.wang <jiajun.wang@gl-inet.com>
---
 src/utils/config.c | 23 +----------------------
 1 file changed, 1 insertion(+), 22 deletions(-)

diff --git a/src/utils/config.c b/src/utils/config.c
index ba26c2c..99fae74 100644
--- a/src/utils/config.c
+++ b/src/utils/config.c
@@ -62,28 +62,7 @@ char * wpa_config_get_line(char *s, int size, FILE *stream, int *line,
 		if (*pos == '#' || *pos == '\n' || *pos == '\0')
 			continue;
 
-		/*
-		 * Remove # comments unless they are within a double quoted
-		 * string.
-		 */
-		sstart = pos;
-		end = os_strchr(sstart, '#');
-		while (end) {
-			sstart = os_strchr(sstart, '"');
-			if (!sstart || sstart > end)
-				break;
-			sstart = os_strchr(sstart + 1, '"');
-			if (!sstart)
-				break;
-			sstart++;
-			if (sstart > end)
-				end = os_strchr(sstart, '#');
-		}
-
-		if (end)
-			*end-- = '\0';
-		else
-			end = pos + os_strlen(pos) - 1;
+		end = pos + os_strlen(pos) - 1;
 
 		/* Remove trailing white space. */
 		while (end > pos &&
-- 
