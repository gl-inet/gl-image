#!/usr/sbin/nft -f

include "/var/run/mptun.nft"

define BYPASS_IP = {127.0.0.1/32, 224.0.0.0/4, 255.255.255.255/32, 192.168.0.0/16, $SERVER}
define TCPPROTO = {tcp}
define UDPPROTO = {udp,icmp}

#代理局域网设备
table inet mproxy {}
flush table inet mproxy
table inet mproxy {
    chain prerouting {
        type filter hook prerouting priority 0;
        ip daddr $BYPASS_IP return
        ip daddr $UDP_ROUTE_IPS meta l4proto $UDPPROTO mark set $UDPMARK accept
        ip daddr $TCP_ROUTE_IPS meta l4proto $TCPPROTO mark set $TCPMARK tproxy ip to 127.0.0.1:$PROXY_PORT accept
    }

    # 代理网关本机
    #chain output {
    #    type route hook output priority 0;
    #    ip daddr $BYPASS_IP return
    #    meta l4proto $TCPPROTO mark set 1 accept
    #}
}


# DIVERT 规则
table inet mpass {}
flush table inet mpass
table inet mpass {
    chain divert {
        type filter hook prerouting priority -150;
        meta l4proto tcp socket transparent 1 meta mark set $TCPMARK accept
    }
}
